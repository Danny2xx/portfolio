---
import {
  profile,
  journey,
  now,
  howIWork,
  ventures,
  credentials,
  testimonials,
  stack,
  currently,
} from "../data/content";
import { inline } from "../lib/inline";
import SectionHead from "./SectionHead.astro";
import StackIcons from "./StackIcons.astro";

const initials = (n: string) => n.split(" ").map((w) => w[0]).join("").slice(0, 2).toUpperCase();
const split = (s: string) => {
  const i = s.indexOf(". ");
  return i === -1 ? { lead: s, rest: "" } : { lead: s.slice(0, i + 1), rest: s.slice(i + 2) };
};
---

<section class="section" id="about">
  <div class="wrap">
    <SectionHead variant="stack" title="About" desc={currently} />

    <div class="about">
      <div class="story" data-reveal>
        <div class="story__who">
          <img class="story__portrait" src="/vector.png" alt={`Illustrated portrait of ${profile.name}`} width="160" height="160" loading="lazy" />
          <div>
            <p class="story__name">{profile.name}</p>
            <p class="story__role">{profile.title}, {profile.location}</p>
          </div>
        </div>
        <div class="story__text">
          {journey.map((p) => <p set:html={inline(p)} />)}
        </div>
      </div>

      <div class="facts">
        <section class="fact" data-reveal>
          <h3 class="fact__title">Right now</h3>
          <dl class="now">
            {now.items.map((it) => (
              <div class="now__row">
                <dt>{it.label}</dt>
                <dd>{it.text}</dd>
              </div>
            ))}
          </dl>
        </section>

        <section class="fact" data-reveal style="--d: 100ms">
          <h3 class="fact__title">How I work</h3>
          <ul class="principles">
            {howIWork.map((h) => {
              const { lead, rest } = split(h);
              return <li><strong>{lead}</strong>{rest && ` ${rest}`}</li>;
            })}
          </ul>
        </section>

        <section class="fact" data-reveal>
          <h3 class="fact__title">Ventures</h3>
          <ul class="plain">
            {ventures.map((v) => (
              <li>
                <p class="plain__lead">{v.role}</p>
                <p class="plain__detail">{v.detail}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="fact" data-reveal style="--d: 100ms">
          <h3 class="fact__title">Education</h3>
          <ul class="plain">
            {credentials.map((c) => (
              <li>
                <p class="plain__lead">{c.line}</p>
                <p class="plain__detail">{c.detail}</p>
              </li>
            ))}
          </ul>
        </section>
      </div>
    </div>

    {testimonials.map((t) => {
      const paras = t.quote.split(/\n\s*\n/).map((s) => s.trim()).filter(Boolean);
      const last = paras.length - 1;
      return (
        <figure class="quote" data-reveal>
          <blockquote class="quote__text">
            {paras.map((para, i) => (
              <p class:list={[i === 0 ? "quote__lead" : "quote__rest"]}>
                {i === 0 && "“"}{para}{i === last && "”"}
              </p>
            ))}
          </blockquote>
          <figcaption class="quote__by">
            {t.photo ? (
              <img class="quote__photo" src={t.photo} alt="" width="48" height="48" loading="lazy" />
            ) : (
              <span class="quote__photo quote__photo--initials" aria-hidden="true">{initials(t.name)}</span>
            )}
            <span class="quote__who">
              <span class="quote__name">
                {t.linkedin ? (
                  <a class="link" href={t.linkedin} target="_blank" rel="noreferrer">{t.name}</a>
                ) : (
                  t.name
                )}
              </span>
              <span class="quote__role">{t.role}{t.linkedin && ", recommendation"}</span>
            </span>
          </figcaption>
        </figure>
      );
    })}

    <div class="tools" data-reveal>
      <h3 class="sub">Tools I reach for</h3>
      <div class="tools__grid">
        <div class="tools__icons"><StackIcons /></div>
        <dl class="skills">
          {stack.map((g) => (
            <div>
              <dt>{g.group}</dt>
              <dd>{g.items.join(", ")}</dd>
            </div>
          ))}
        </dl>
      </div>
    </div>
  </div>
</section>

<style>
  .about { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 3.5rem var(--col-gap); }

  .story { grid-column: 1 / span 5; }
  .story__who { display: flex; align-items: center; gap: 1rem; margin-bottom: 1.8rem; }
  .story__portrait {
    width: 72px;
    height: 72px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 28%;
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line);
  }
  .story__name { font-size: 1.1rem; font-weight: 640; font-stretch: 108%; }
  .story__role { font-size: 0.88rem; color: var(--faint); }
  .story__text { display: flex; flex-direction: column; gap: 1.05rem; color: var(--muted); font-size: 1.02rem; line-height: 1.7; }
  .story__text p:first-child { color: var(--ink); }

  .facts {
    grid-column: 7 / -1;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.8rem 2.2rem;
    align-content: start;
  }
  .fact__title {
    margin-bottom: 1rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.98rem;
    font-weight: 640;
    font-stretch: 106%;
  }
  .now { display: flex; flex-direction: column; gap: 0.65rem; margin: 0; }
  .now__row { display: grid; grid-template-columns: 5.4rem minmax(0, 1fr); gap: 0.8rem; }
  .now dt { font-size: 0.86rem; color: var(--faint); }
  .now dd { margin: 0; font-size: 0.92rem; }
  .principles { list-style: none; display: flex; flex-direction: column; gap: 0.75rem; margin: 0; padding: 0; color: var(--muted); font-size: 0.92rem; }
  .principles strong { color: var(--ink); font-weight: 620; }
  .plain { list-style: none; display: flex; flex-direction: column; gap: 1.05rem; margin: 0; padding: 0; }
  .plain__lead { font-size: 0.92rem; font-weight: 600; line-height: 1.4; }
  .plain__detail { margin-top: 0.2rem; font-size: 0.88rem; color: var(--muted); }

  .quote {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 2rem;
    margin: clamp(5rem, 11vw, 7.5rem) 0 0;
    padding-top: clamp(2.8rem, 6vw, 4rem);
    border-top: 1px solid var(--line);
  }
  .quote__text { grid-column: 1 / span 10; margin: 0; }
  .quote__lead {
    font-size: clamp(1.55rem, 1.05rem + 1.8vw, 2.6rem);
    font-stretch: 104%;
    font-weight: 560;
    line-height: 1.22;
    letter-spacing: -0.022em;
    text-wrap: balance;
  }
  .quote__rest { max-width: 64ch; margin-top: 1.3rem; color: var(--muted); }
  .quote__by { grid-column: 1 / -1; display: flex; align-items: center; gap: 0.85rem; }
  .quote__photo { flex: none; width: 48px; height: 48px; border-radius: 50%; object-fit: cover; }
  .quote__photo--initials {
    display: grid;
    place-items: center;
    background: var(--hl);
    color: var(--on-hl);
    font-size: 0.85rem;
    font-weight: 700;
  }
  .quote__who { display: flex; flex-direction: column; line-height: 1.35; }
  .quote__name { font-weight: 640; }
  .quote__role { font-size: 0.88rem; color: var(--faint); }

  .tools { margin-top: clamp(5rem, 11vw, 7.5rem); }
  .sub { font-size: clamp(1.3rem, 1.05rem + 0.8vw, 1.75rem); font-stretch: 110%; font-weight: 680; letter-spacing: -0.025em; }
  .tools__grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: 2.5rem var(--col-gap); margin-top: 1.8rem; }
  .tools__icons { grid-column: 1 / span 6; }
  .skills { grid-column: 8 / -1; display: flex; flex-direction: column; gap: 0.95rem; margin: 0; }
  .skills dt { font-size: 0.84rem; color: var(--faint); }
  .skills dd { margin: 0.1rem 0 0; font-size: 0.94rem; }

  @media (max-width: 1000px) {
    .story, .facts, .tools__icons, .skills { grid-column: 1 / -1; }
  }
  @media (max-width: 600px) {
    .facts { grid-template-columns: 1fr; }
    .quote__text { grid-column: 1 / -1; }
  }
</style>
