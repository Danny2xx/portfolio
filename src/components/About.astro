---
import {
  profile,
  experience,
  publications,
  awards,
  alsoRecognised,
  testimonials,
} from "../data/content";
import StackIcons from "./StackIcons.astro";

const initials = (n: string) =>
  n.split(" ").map((w) => w[0]).join("").slice(0, 2).toUpperCase();
---

<section class="sec" id="experience" data-reveal>
  <div class="sec__head">
    <h2 class="sec__title">Experience</h2>
    {profile.cvUrl && (
      <a class="sec__aside link link--quiet" href={profile.cvUrl} target="_blank" rel="noreferrer">Full CV</a>
    )}
  </div>
  <ol class="rows">
    {experience.map((job) => (
      <li class="row">
        <span class="row__when">{job.range}</span>
        <div>
          <h3 class="row__title">
            {job.role}
            <span class="row__at"> at </span>
            {job.orgUrl ? (
              <a class="link" href={job.orgUrl} target="_blank" rel="noreferrer">{job.org}</a>
            ) : (
              job.org
            )}
          </h3>
          {job.place && <p class="row__place">{job.place}</p>}
          <p class="row__note">{job.note}</p>
        </div>
      </li>
    ))}
  </ol>
</section>

{publications.length > 0 && (
  <section class="sec" id="research" data-reveal>
    <div class="sec__head">
      <h2 class="sec__title">Research</h2>
    </div>
    {publications.map((p) => (
      <article class="paper">
        <a class="paper__thumb" href={p.pdf} target="_blank" rel="noreferrer" tabindex="-1" aria-hidden="true">
          <img src={p.thumb} alt="" width="320" height="452" decoding="async" />
        </a>
        <div class="paper__body">
          <p class="paper__venue">
            <span class="paper__status">{p.status}</span>
            {p.venue}
          </p>
          <h3 class="paper__title">
            <a href={p.pdf} target="_blank" rel="noreferrer">{p.title}</a>
          </h3>
          <p class="paper__authors">
            {p.authors.map((a, i) => (
              <><span class:list={[{ "paper__me": a === profile.name }]}>{a}</span>{i < p.authors.length - 1 && ", "}</>
            ))}
          </p>
          <p class="paper__aff">{p.affiliations}</p>
          <p class="paper__summary">{p.summary}</p>
          <p class="paper__links">
            <a class="link" href={p.pdf} target="_blank" rel="noreferrer">Read the paper</a>
            <span class="meta">PDF, {p.pages} pages</span>
          </p>
        </div>
      </article>
    ))}
  </section>
)}

<section class="sec" id="recognition" data-reveal>
  <div class="sec__head">
    <h2 class="sec__title">Recognition</h2>
  </div>
  <ol class="rows">
    {awards.map((a) => (
      <li class="row">
        <span class="row__when">{a.date}</span>
        <div>
          <h3 class="row__title">
            {a.place}<span class="row__at"> at </span>{a.event}
          </h3>
          {a.detail && <p class="row__note">{a.detail}</p>}
          {(a.proof || a.href) && (
            <p class="row__links">
              {a.proof && <a class="link link--quiet" href={a.proof} target="_blank" rel="noreferrer">Certificate</a>}
              {a.href && <a class="link link--quiet" href={a.href} target="_blank" rel="noreferrer">Announcement</a>}
            </p>
          )}
        </div>
      </li>
    ))}
  </ol>

  {alsoRecognised.length > 0 && (
    <ul class="also">
      {alsoRecognised.map((m) => (
        <li class="also__item">
          <span class="also__what">{m.what}</span>
          <span class="also__detail">{m.detail}</span>
        </li>
      ))}
    </ul>
  )}
</section>

<section class="sec" id="stack" data-reveal>
  <div class="sec__head">
    <h2 class="sec__title">Tools I reach for</h2>
    <a class="sec__aside link link--quiet" href="/uses">Everything I use</a>
  </div>
  <StackIcons />
</section>

{testimonials.length > 0 && (
  <section class="sec" id="recommendations" data-reveal>
    <div class="sec__head">
      <h2 class="sec__title">Recommendations</h2>
    </div>
    {testimonials.map((t) => {
      const paras = t.quote.split(/\n\s*\n/).map((s) => s.trim()).filter(Boolean);
      const last = paras.length - 1;
      return (
        <figure class="rec">
          <blockquote class="rec__quote">
            {paras.map((para, i) => (
              <p class:list={[i === 0 ? "rec__lead" : "rec__rest"]}>
                {i === 0 && "“"}{para}{i === last && "”"}
              </p>
            ))}
          </blockquote>
          <figcaption class="rec__by">
            {t.photo ? (
              <img class="rec__photo" src={t.photo} alt="" width="40" height="40" loading="lazy" />
            ) : (
              <span class="rec__photo rec__photo--initials" aria-hidden="true">{initials(t.name)}</span>
            )}
            <span class="rec__who">
              <span class="rec__name">
                {t.linkedin ? (
                  <a class="link" href={t.linkedin} target="_blank" rel="noreferrer">{t.name}</a>
                ) : (
                  t.name
                )}
              </span>
              <span class="rec__role">{t.role}</span>
            </span>
            {t.linkedin && (
              <a class="rec__li" href={t.linkedin} target="_blank" rel="noreferrer" aria-label={`${t.name} on LinkedIn`}>
                <svg viewBox="0 0 24 24" width="15" height="15" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.3c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9V9Z"/></svg>
              </a>
            )}
          </figcaption>
        </figure>
      );
    })}
  </section>
)}

<div class="sec more" data-reveal>
  <a class="link" href="/about">The longer version</a>
  <span class="meta">My journey, ventures, education and how I work.</span>
</div>

<style>
  /* dated rows: experience + recognition */
  .rows { list-style: none; margin: 0; padding: 0; }
  .row {
    display: grid;
    grid-template-columns: 8.25rem 1fr;
    gap: 1.25rem;
    padding: 1.05rem 0;
    border-top: 1px solid var(--border);
  }
  .row:first-child { border-top: 0; padding-top: 0.1rem; }
  .row__when { font-size: 0.8rem; color: var(--faint); padding-top: 0.1rem; white-space: nowrap; }
  .row__title { font-size: 0.92rem; font-weight: 600; letter-spacing: -0.006em; line-height: 1.4; }
  .row__at { color: var(--faint); font-weight: 400; }
  .row__place { font-size: 0.8rem; color: var(--faint); margin-top: 0.05rem; }
  .row__note { color: var(--muted); margin-top: 0.35rem; max-width: 60ch; }
  .row__links { display: flex; flex-wrap: wrap; gap: 0.3rem 1.1rem; margin-top: 0.5rem; font-size: 0.8rem; }
  @media (max-width: 560px) {
    .row { grid-template-columns: 1fr; gap: 0.2rem; }
  }

  /* research */
  .paper { display: grid; grid-template-columns: 6.75rem 1fr; gap: 1.35rem; align-items: start; }
  .paper__thumb {
    display: block;
    border-radius: 3px;
    overflow: hidden;
    background: oklch(1 0 0);
    box-shadow: 0 0 0 1px var(--border), 0 14px 28px -18px oklch(0 0 0 / 0.35);
    transition: transform 0.4s var(--ease-out), box-shadow 0.4s ease;
  }
  .paper__thumb img { display: block; width: 100%; height: auto; }
  .paper__thumb:hover { transform: translateY(-3px); box-shadow: 0 0 0 1px var(--border-strong), 0 20px 34px -18px oklch(0 0 0 / 0.4); }
  :global(:root[data-theme="dark"]) .paper__thumb img { filter: brightness(0.9); }
  .paper__venue { display: flex; align-items: center; gap: 0.5rem; font-size: 0.8rem; color: var(--muted); }
  .paper__status {
    font-size: 0.72rem;
    font-weight: 600;
    color: var(--primary-hi);
    background: color-mix(in oklab, var(--primary) 11%, transparent);
    border-radius: 4px;
    padding: 0.06rem 0.4rem;
  }
  .paper__title { margin-top: 0.5rem; font-size: 1rem; line-height: 1.32; letter-spacing: -0.012em; text-wrap: pretty; }
  .paper__title a { transition: color 0.2s ease; }
  .paper__title a:hover { color: var(--primary-hi); }
  .paper__authors { margin-top: 0.4rem; font-size: 0.82rem; color: var(--muted); }
  .paper__me { color: var(--ink); font-weight: 600; }
  .paper__aff { font-size: 0.8rem; color: var(--faint); }
  .paper__summary { margin-top: 0.65rem; color: var(--muted); max-width: 58ch; }
  .paper__links { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.7rem; margin-top: 0.75rem; }
  @media (max-width: 520px) {
    .paper { grid-template-columns: 4.6rem 1fr; gap: 1rem; }
  }

  /* also recognised */
  .also {
    list-style: none;
    margin: 1.3rem 0 0;
    padding: 1rem 0 0;
    border-top: 1px dashed var(--border-strong);
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
  }
  .also__item { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.1rem 0.6rem; font-size: 0.84rem; }
  .also__what { color: var(--ink); }
  .also__detail { color: var(--faint); font-size: 0.8rem; }

  /* recommendations */
  .rec { margin: 0; }
  .rec + .rec { margin-top: 2rem; padding-top: 2rem; border-top: 1px solid var(--border); }
  .rec__quote { margin: 0; }
  .rec__lead {
    max-width: 52ch;
    font-size: 1.08rem;
    font-weight: 500;
    line-height: 1.48;
    letter-spacing: -0.01em;
    color: var(--ink);
  }
  .rec__rest { margin-top: 0.75rem; max-width: 60ch; color: var(--muted); }
  .rec__by { display: flex; align-items: center; gap: 0.7rem; margin-top: 1.15rem; }
  .rec__photo { flex: none; width: 36px; height: 36px; border-radius: 50%; object-fit: cover; }
  .rec__photo--initials {
    display: grid;
    place-items: center;
    background: var(--surface-2);
    color: var(--muted);
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.02em;
  }
  .rec__who { display: flex; flex-direction: column; line-height: 1.35; min-width: 0; }
  .rec__name { font-size: 0.88rem; font-weight: 600; }
  .rec__role { font-size: 0.8rem; color: var(--faint); }
  .rec__li {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin-left: 0.2rem;
    border-radius: 7px;
    color: var(--faint);
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .rec__li:hover { color: var(--ink); background: var(--surface-2); }

  .more { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.3rem 0.7rem; }
</style>
