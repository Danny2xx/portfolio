---
import { profile } from "../data/content";
---

<dialog id="cmdk" class="cmdk" aria-label="Command palette">
  <div class="cmdk__panel">
    <div class="cmdk__inputwrap">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" aria-hidden="true">
        <circle cx="11" cy="11" r="7" stroke="currentColor" stroke-width="1.7"/>
        <path d="m20 20-3.2-3.2" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      </svg>
      <input id="cmdk-input" type="text" placeholder="Type a command or search…" autocomplete="off" spellcheck="false" aria-label="Command search" />
      <kbd class="cmdk__esc mono">esc</kbd>
    </div>

    <ul id="cmdk-list" class="cmdk__list" role="listbox" aria-label="Commands">
      <li class="cmdk__group mono">Navigate</li>
      <li class="cmd" role="option" data-act="go" data-href="/#about" data-kw="about experience stack">
        <span class="cmd__ic" aria-hidden="true">▸</span> About <span class="cmd__hint mono">experience · stack</span>
      </li>
      <li class="cmd" role="option" data-act="go" data-href="/#projects" data-kw="work projects portfolio">
        <span class="cmd__ic" aria-hidden="true">▸</span> Projects
      </li>
      <li class="cmd" role="option" data-act="go" data-href="/#lab" data-kw="lab demos interactive">
        <span class="cmd__ic" aria-hidden="true">▸</span> Lab <span class="cmd__hint mono">live demos</span>
      </li>
      <li class="cmd" role="option" data-act="go" data-href="/#contact" data-kw="contact hire email">
        <span class="cmd__ic" aria-hidden="true">▸</span> Contact
      </li>
      <li class="cmd" role="option" data-act="go" data-href="/about" data-kw="about me journey bio">
        <span class="cmd__ic" aria-hidden="true">▸</span> About me <span class="cmd__hint mono">journey · how I work</span>
      </li>
      <li class="cmd" role="option" data-act="go" data-href="/now" data-kw="now current focus updates">
        <span class="cmd__ic" aria-hidden="true">▸</span> Now <span class="cmd__hint mono">current focus</span>
      </li>
      <li class="cmd" role="option" data-act="go" data-href="/uses" data-kw="uses tools stack setup">
        <span class="cmd__ic" aria-hidden="true">▸</span> Uses <span class="cmd__hint mono">tools & stack</span>
      </li>
      <li class="cmd" role="option" data-act="go" data-href="/writing" data-kw="writing notes blog posts">
        <span class="cmd__ic" aria-hidden="true">▸</span> Writing <span class="cmd__hint mono">notes</span>
      </li>

      <li class="cmdk__group mono">Actions</li>
      <li class="cmd" role="option" data-act="theme" data-kw="theme dark light mode toggle">
        <span class="cmd__ic" aria-hidden="true">◐</span> Toggle theme
      </li>
      <li class="cmd" role="option" data-act="contrast" data-kw="contrast accessibility a11y">
        <span class="cmd__ic" aria-hidden="true">◑</span> Toggle high contrast
      </li>

      <li class="cmdk__group mono">Connect</li>
      <li class="cmd" role="option" data-act="link" data-href={`mailto:${profile.email}`} data-kw="email contact mail">
        <span class="cmd__ic" aria-hidden="true">✉</span> Email me <span class="cmd__hint mono">{profile.email}</span>
      </li>
      <li class="cmd" role="option" data-act="ext" data-href={profile.links.github} data-kw="github code source">
        <span class="cmd__ic" aria-hidden="true">⌥</span> GitHub <span class="cmd__hint mono">/Danny2xx</span>
      </li>
      <li class="cmd" role="option" data-act="ext" data-href={profile.links.linkedin} data-kw="linkedin">
        <span class="cmd__ic" aria-hidden="true">in</span> LinkedIn
      </li>

      <li id="cmdk-empty" class="cmdk__empty" hidden>No matches</li>
    </ul>

    <div class="cmdk__foot mono">
      <span><kbd>↑↓</kbd> navigate</span>
      <span><kbd>↵</kbd> select</span>
    </div>
  </div>
</dialog>

<style>
  .cmdk {
    margin: 0; padding: 0; border: 0; background: transparent;
    max-width: none; max-height: none;
    position: fixed; inset: 0; width: 100%; height: 100%;
  }
  .cmdk[open] { display: flex; align-items: flex-start; justify-content: center; }
  .cmdk::backdrop {
    background: color-mix(in oklab, var(--bg) 50%, black 25%);
    backdrop-filter: blur(5px); -webkit-backdrop-filter: blur(5px);
  }
  .cmdk__panel {
    margin-top: clamp(3.5rem, 12vh, 8rem);
    width: min(560px, calc(100vw - 2rem));
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 16px;
    box-shadow: 0 40px 90px -50px oklch(0 0 0 / 0.5);
    overflow: hidden;
    animation: cmdk-in 0.18s cubic-bezier(0.16, 1, 0.3, 1);
  }
  @keyframes cmdk-in { from { opacity: 0; transform: translateY(-8px); } to { opacity: 1; transform: none; } }

  .cmdk__inputwrap { display: flex; align-items: center; gap: 0.6rem; padding: 0.85rem 1rem; border-bottom: 1px solid var(--border); color: var(--faint); }
  .cmdk__inputwrap input { flex: 1; background: none; border: 0; outline: none; font: inherit; font-size: 0.98rem; color: var(--ink); }
  .cmdk__inputwrap input::placeholder { color: var(--faint); }
  .cmdk__esc { font-size: 0.66rem; color: var(--faint); border: 1px solid var(--border); border-radius: 5px; padding: 0.1rem 0.35rem; }

  .cmdk__list { list-style: none; margin: 0; padding: 0.4rem; max-height: 50vh; overflow-y: auto; }
  .cmdk__group { font-size: 0.64rem; letter-spacing: 0.12em; text-transform: uppercase; color: var(--faint); padding: 0.6rem 0.7rem 0.3rem; }
  .cmd {
    display: flex; align-items: center; gap: 0.7rem;
    padding: 0.6rem 0.7rem; border-radius: 9px; cursor: pointer;
    font-size: 0.92rem; color: var(--ink);
  }
  .cmd__ic { width: 1.2rem; text-align: center; color: var(--muted); font-size: 0.85rem; }
  .cmd__hint { margin-left: auto; font-size: 0.72rem; color: var(--faint); }
  .cmd.is-active, .cmd:hover { background: var(--surface-2); }
  .cmd.is-active .cmd__ic { color: var(--primary); }
  .cmd[hidden] { display: none; }
  .cmdk__empty { padding: 1.2rem 0.7rem; color: var(--faint); text-align: center; font-size: 0.9rem; }

  .cmdk__foot { display: flex; gap: 1.2rem; padding: 0.55rem 1rem; border-top: 1px solid var(--border); font-size: 0.68rem; color: var(--faint); }
  .cmdk__foot kbd { border: 1px solid var(--border); border-radius: 4px; padding: 0 0.3rem; }

  @media (prefers-reduced-motion: reduce) { .cmdk__panel { animation: none; } }
</style>

<script>
  const dlg = document.getElementById("cmdk") as HTMLDialogElement;
  const input = document.getElementById("cmdk-input") as HTMLInputElement;
  const list = document.getElementById("cmdk-list")!;
  const empty = document.getElementById("cmdk-empty")!;
  const cmds = Array.from(list.querySelectorAll<HTMLElement>(".cmd"));
  let active = 0;

  function visible() { return cmds.filter((c) => !c.hidden); }
  function setActive(i: number) {
    const vis = visible();
    if (!vis.length) return;
    active = (i + vis.length) % vis.length;
    cmds.forEach((c) => c.classList.remove("is-active"));
    vis[active].classList.add("is-active");
    vis[active].scrollIntoView({ block: "nearest" });
  }
  function filter() {
    const q = input.value.trim().toLowerCase();
    let any = false;
    cmds.forEach((c) => {
      const hay = (c.textContent + " " + (c.dataset.kw || "")).toLowerCase();
      const show = !q || hay.includes(q);
      c.hidden = !show;
      if (show) any = true;
    });
    // hide empty groups
    list.querySelectorAll<HTMLElement>(".cmdk__group").forEach((g) => {
      let n = g.nextElementSibling as HTMLElement | null, shown = false;
      while (n && !n.classList.contains("cmdk__group") && n.id !== "cmdk-empty") {
        if (n.classList.contains("cmd") && !n.hidden) shown = true;
        n = n.nextElementSibling as HTMLElement | null;
      }
      g.hidden = !shown;
    });
    empty.hidden = any;
    active = 0; setActive(0);
  }

  function open() {
    if (dlg.open) return;
    dlg.showModal();
    input.value = ""; filter(); input.focus();
  }
  function run(cmd: HTMLElement) {
    const act = cmd.dataset.act, href = cmd.dataset.href || "";
    dlg.close();
    switch (act) {
      case "go": location.href = href; break;
      case "ext": window.open(href, "_blank", "noopener"); break;
      case "link": location.href = href; break;
      case "theme": (window as any).__toggleTheme?.(); break;
      case "contrast": {
        const root = document.documentElement;
        const on = root.dataset.contrast === "high";
        try {
          if (on) { localStorage.removeItem("a11y-contrast"); delete root.dataset.contrast; }
          else { localStorage.setItem("a11y-contrast", "high"); root.dataset.contrast = "high"; }
        } catch {}
        break;
      }
    }
  }

  document.addEventListener("keydown", (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === "k") { e.preventDefault(); dlg.open ? dlg.close() : open(); return; }
    if (!dlg.open) return;
    if (e.key === "ArrowDown") { e.preventDefault(); setActive(active + 1); }
    else if (e.key === "ArrowUp") { e.preventDefault(); setActive(active - 1); }
    else if (e.key === "Enter") { e.preventDefault(); const v = visible(); if (v[active]) run(v[active]); }
  });
  input.addEventListener("input", filter);
  cmds.forEach((c) => c.addEventListener("click", () => run(c)));
  dlg.addEventListener("click", (e) => { if (e.target === dlg) dlg.close(); });

  // expose an opener for the dock / any [data-open-cmdk]
  document.addEventListener("click", (e) => {
    if ((e.target as HTMLElement).closest("[data-open-cmdk]")) { e.preventDefault(); open(); }
  });
</script>
