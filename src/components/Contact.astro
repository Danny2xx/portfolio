---
import { profile, strengths } from "../data/content";
---

<section class="section">
  <div class="section__head" data-reveal>
    <span class="label">Contact</span>
  </div>

  <div class="contact" data-reveal>
    <h2 class="contact__head">Let's build something.</h2>
    <p class="contact__lead">
      Finishing my MSc in 2026 and <strong>open to work</strong>: Applied AI / ML Engineer
      roles, {profile.location}. The fastest way to reach me is email.
    </p>

    <a class="contact__email" href={`mailto:${profile.email}`}>
        <span class="contact__email-icon" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="none"><rect x="3" y="5" width="18" height="14" rx="2.5" stroke="currentColor" stroke-width="1.7"/><path d="m4 7 8 6 8-6" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </span>
        <span class="contact__email-text">{profile.email}</span>
        <span class="contact__email-go mono" aria-hidden="true">→</span>
    </a>

    <div class="contact__links">
        <a class="contact__link" href={profile.links.github} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.22-3.37-1.22-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>
          <span>GitHub <span class="contact__handle mono">/Danny2xx</span></span>
        </a>
        <a class="contact__link" href={profile.links.linkedin} target="_blank" rel="noreferrer">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.3c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9V9Z"/></svg>
          <span>LinkedIn <span class="contact__handle mono">/daniel-iyalekhue</span></span>
        </a>
        {profile.cvUrl && (
          <a class="contact__link" href={profile.cvUrl} download>
            <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M12 3v11m0 0 4-4m-4 4-4-4M5 19h14" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"/></svg>
            <span>Download CV <span class="contact__handle mono">PDF</span></span>
          </a>
        )}
    </div>
  </div>

  <hr class="rule contact__rule" />

  <div class="section__head" data-reveal>
    <span class="label">Strengths</span>
  </div>
  <ul class="strengths" data-reveal>
    {strengths.map((s) => <li class="strength">{s}</li>)}
  </ul>
</section>

<style>
  .section { padding-block: clamp(3rem, 7vw, 5rem); }
  .section__head { margin-bottom: 1.6rem; }
  .contact__rule { margin-block: clamp(2.6rem, 6vw, 3.6rem); }

  .contact { max-width: 60ch; }
  .contact__head {
    font-size: clamp(1.2rem, 1rem + 1.2vw, 1.5rem);
    margin-bottom: 0.7rem;
  }
  .contact__lead { color: var(--muted); font-size: 0.88rem; }
  .contact__lead strong { color: var(--ink); font-weight: 640; }

  .contact__email {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    margin-top: 1.6rem;
    padding: 1rem 1.1rem;
    border-radius: 13px;
    border: 1px solid var(--border-strong);
    background: linear-gradient(180deg, color-mix(in oklab, var(--surface) 55%, transparent), var(--surface));
    transition: border-color 0.2s ease, transform 0.2s cubic-bezier(0.16,1,0.3,1), box-shadow 0.2s ease;
  }
  .contact__email:hover {
    border-color: var(--primary);
    transform: translateY(-2px);
    box-shadow: 0 18px 40px -26px var(--glow-primary);
  }
  .contact__email-icon {
    display: grid; place-items: center; flex: none;
    width: 36px; height: 36px; border-radius: 9px;
    background: var(--primary); color: var(--on-primary);
    box-shadow: 0 8px 20px -10px var(--glow-primary);
  }
  .contact__email-icon svg { width: 17px; height: 17px; }
  .contact__email-text { font-size: 0.92rem; font-weight: 560; color: var(--ink); }
  .contact__email-go { margin-left: auto; color: var(--primary); font-size: 1.1rem; }

  .contact__links { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 0.9rem; }
  .contact__link {
    display: inline-flex; align-items: center; gap: 0.6rem;
    padding: 0.7rem 0.95rem; border-radius: 11px;
    border: 1px solid var(--border); background: var(--surface);
    color: var(--ink); font-size: 0.92rem; font-weight: 540;
    transition: border-color 0.18s ease, color 0.18s ease, transform 0.18s ease;
  }
  .contact__link:hover { border-color: var(--primary); transform: translateY(-1px); }
  .contact__link svg { color: var(--muted); }
  .contact__handle { color: var(--faint); font-size: 0.8rem; }

  .contact__ask {
    display: inline-flex; align-items: center; gap: 0.5rem;
    margin-top: 1.3rem; font: inherit; font-size: 0.9rem; cursor: pointer;
    color: var(--muted); background: none; border: 0; padding: 0;
    transition: color 0.18s ease;
  }
  .contact__ask span[aria-hidden] { color: var(--accent); }
  .contact__ask:hover { color: var(--ink); }

  .strengths { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem; }
  .strength {
    font-size: 0.86rem; color: var(--ink);
    border: 1px solid var(--border); background: var(--surface);
    border-radius: 8px; padding: 0.45rem 0.75rem;
  }
</style>

<script>
  // Magnetic pull on the email CTA — it leans toward the cursor.
  const btn = document.querySelector<HTMLAnchorElement>(".contact__email");
  const okHover = window.matchMedia("(hover: hover)").matches;
  const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
  if (btn && okHover && !reduce) {
    const S = 0.22;
    btn.addEventListener("pointermove", (e) => {
      const r = btn.getBoundingClientRect();
      const x = (e.clientX - (r.left + r.width / 2)) * S;
      const y = (e.clientY - (r.top + r.height / 2)) * S;
      btn.style.transform = `translate(${x.toFixed(1)}px, ${(y - 2).toFixed(1)}px)`;
    });
    btn.addEventListener("pointerleave", () => { btn.style.transform = ""; });
  }
</script>
