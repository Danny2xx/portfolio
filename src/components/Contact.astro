---
import { profile } from "../data/content";

const handle = (url: string) => url.replace(/\/$/, "").split("/").pop();
---

<section class="section contact" id="contact">
  <div class="wrap">
    <p class="contact__status" data-reveal><span class="light" aria-hidden="true"></span>{profile.status}</p>

    <h2 class="contact__title display" data-split>
      <span class="mask"><span>Need AI that works</span></span>
      <span class="mask"><span><mark class="hl-mark" style="--hl-delay: 750ms">after the demo?</mark></span></span>
    </h2>

    <div class="contact__mail" data-reveal style="--d: 150ms">
      <a class="contact__email" href={`mailto:${profile.email}`}>{profile.email}</a>
      <button type="button" class="btn btn--ghost contact__copy" data-copy={profile.email}>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="8" y="8" width="12" height="12" rx="2.5" /><path d="M16 8V6.5A2.5 2.5 0 0 0 13.5 4h-7A2.5 2.5 0 0 0 4 6.5v7A2.5 2.5 0 0 0 6.5 16H8" /></svg>
        <span data-copy-label>Copy address</span>
      </button>
    </div>

    <div class="contact__foot" data-reveal style="--d: 250ms">
      <ul class="contact__links">
        <li>
          <a href={profile.links.linkedin} target="_blank" rel="noreferrer">
            <span>LinkedIn</span><span class="contact__handle">{handle(profile.links.linkedin)}</span>
          </a>
        </li>
        <li>
          <a href={profile.links.github} target="_blank" rel="noreferrer">
            <span>GitHub</span><span class="contact__handle">{handle(profile.links.github)}</span>
          </a>
        </li>
        {profile.cvUrl && (
          <li>
            <a href={profile.cvUrl} target="_blank" rel="noreferrer">
              <span>Résumé</span><span class="contact__handle">PDF</span>
            </a>
          </li>
        )}
      </ul>
      <p class="contact__clock" data-clock>
        It's <span class="contact__time" data-time>…</span> in Birmingham, where I'm based. Open to roles in
        the UK and remote.
      </p>
    </div>
  </div>
</section>

<style>
  .contact { padding-block: clamp(6rem, 14vw, 10rem) clamp(5rem, 10vw, 7rem); }
  .contact__status { display: inline-flex; align-items: center; gap: 0.65rem; color: var(--muted); }
  .contact__title { max-width: 16ch; margin-top: 1.6rem; font-size: clamp(2.6rem, 0.8rem + 6.6vw, 6rem); }
  .contact__title .hl-mark { padding-inline: 0.06em; }

  .contact__mail { display: flex; flex-wrap: wrap; align-items: center; gap: 1rem 1.5rem; margin-top: clamp(2.6rem, 6vw, 4rem); }
  .contact__email {
    padding: 0 0.06em 0.06em;
    font-size: clamp(1.35rem, 0.65rem + 2.9vw, 3.2rem);
    font-weight: 640;
    font-stretch: 106%;
    letter-spacing: -0.03em;
    line-height: 1.15;
    overflow-wrap: anywhere;
    background: linear-gradient(var(--hl), var(--hl)) no-repeat 0 100% / 100% 3px;
    transition: background-size 0.55s var(--ease-out), color 0.3s ease;
  }
  .contact__email:hover,
  .contact__email:focus-visible { background-size: 100% 100%; color: var(--on-hl); }
  .contact__copy { height: 2.7rem; }
  .contact__copy[data-state="done"] { border-color: var(--hl-text); color: var(--hl-text); }

  .contact__foot {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 2rem;
    align-items: end;
    margin-top: clamp(3.2rem, 7vw, 5rem);
  }
  .contact__links { grid-column: 1 / span 6; list-style: none; margin: 0; padding: 0; }
  .contact__links a {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.05rem 0;
    border-top: 1px solid var(--line);
    font-size: 1.08rem;
    font-weight: 580;
  }
  .contact__links li:last-child a { border-bottom: 1px solid var(--line); }
  .contact__handle { font-size: 0.9rem; font-weight: 400; color: var(--faint); transition: color 0.3s ease, transform 0.5s var(--ease-out); }
  .contact__links a:hover .contact__handle { color: var(--hl-text); transform: translateX(-5px); }
  .contact__clock { grid-column: 8 / -1; justify-self: end; max-width: 32ch; text-align: right; color: var(--muted); }
  .contact__time { color: var(--ink); font-weight: 640; }

  @media (max-width: 860px) {
    .contact__links, .contact__clock { grid-column: 1 / -1; }
    .contact__clock { justify-self: start; text-align: left; }
  }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((btn) => {
    const label = btn.querySelector<HTMLElement>("[data-copy-label]");
    let timer = 0;
    btn.addEventListener("click", async () => {
      try {
        await navigator.clipboard.writeText(btn.dataset.copy!);
        if (label) label.textContent = "Copied";
        btn.dataset.state = "done";
      } catch {
        if (label) label.textContent = "Copy failed";
      }
      window.clearTimeout(timer);
      timer = window.setTimeout(() => {
        if (label) label.textContent = "Copy address";
        delete btn.dataset.state;
      }, 1800);
    });
  });

  // live Birmingham time
  const time = document.querySelector("[data-clock] [data-time]");
  if (time) {
    const tick = () =>
      (time.textContent = new Date().toLocaleTimeString("en-GB", {
        hour: "2-digit",
        minute: "2-digit",
        timeZone: "Europe/London",
      }));
    tick();
    window.setInterval(tick, 30_000);
  }
</script>
