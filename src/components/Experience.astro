---
import { experience } from "../data/content";
import SectionHead from "./SectionHead.astro";
---

<section class="section" id="experience">
  <div class="wrap">
    <SectionHead
      variant="stack"
      title="Experience"
      desc="Applied AI engineering, data science and R&D, most recent first."
    />

    <div class="xp" data-progress>
      <div class="xp__railwrap" aria-hidden="true">
        <span class="xp__rail"><span class="xp__fill"></span></span>
      </div>

      <ol class="xp__list">
        {experience.map((job) => (
          <li class="xp__item" data-reveal>
            <p class="xp__when">{job.range}</p>
            <div class="xp__body" data-mark>
              <h3 class="xp__role">{job.role}</h3>
              <p class="xp__org">
                {job.orgUrl ? (
                  <a class="link" href={job.orgUrl} target="_blank" rel="noreferrer">{job.org}</a>
                ) : (
                  <span class="xp__orgname">{job.org}</span>
                )}
                {job.place && <span class="xp__place">{job.place}</span>}
                {job.current && <span class="badge badge--line">Current</span>}
              </p>
              <p class="xp__note">{job.note}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .xp { position: relative; }

  /* the rail shares the list's grid so it sits exactly at the content column */
  .xp__railwrap {
    position: absolute;
    inset: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    pointer-events: none;
  }
  .xp__rail { position: relative; grid-column: 4; width: 1px; background: var(--line); }
  .xp__fill {
    position: absolute;
    inset: 0;
    background: var(--hl-text);
    transform-origin: top;
    transform: scaleY(var(--p, 0));
  }

  .xp__list { list-style: none; margin: 0; padding: 0; }
  .xp__item {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    padding-block: clamp(1.8rem, 4vw, 2.8rem);
  }
  .xp__item:first-child { padding-top: 0.4rem; }
  .xp__when { grid-column: 1 / span 3; padding-top: 0.45rem; font-size: 0.95rem; color: var(--faint); }
  .xp__body { position: relative; grid-column: 4 / -1; padding-left: clamp(1.5rem, 3.2vw, 3rem); }
  .xp__body::before {
    content: "";
    position: absolute;
    left: -5px;
    top: 0.75rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--bg);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: background-color 0.5s ease, box-shadow 0.5s ease;
  }
  .xp__body:global(.is-passed)::before { background: var(--hl); box-shadow: 0 0 0 5px var(--hl-soft); }

  .xp__role { font-size: clamp(1.35rem, 1rem + 1.1vw, 1.85rem); font-stretch: 110%; font-weight: 660; letter-spacing: -0.025em; }
  .xp__org { display: flex; flex-wrap: wrap; align-items: center; gap: 0.35rem 0.85rem; margin-top: 0.5rem; color: var(--ink); }
  .xp__place { font-size: 0.9rem; color: var(--faint); }
  .xp__note { max-width: 62ch; margin-top: 0.9rem; color: var(--muted); }

  @media (max-width: 760px) {
    .xp__railwrap { display: block; }
    .xp__rail { position: absolute; left: 0; top: 0; bottom: 0; }
    .xp__item { grid-template-columns: 1fr; padding-left: 1.6rem; }
    .xp__when { grid-column: 1; padding-top: 0; margin-bottom: 0.35rem; font-size: 0.88rem; }
    .xp__body { grid-column: 1; padding-left: 0; }
    .xp__body::before { left: calc(-1.6rem - 5px); top: -1.55rem; }
  }
</style>
