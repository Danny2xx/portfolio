---
import { profile } from "../data/content";
import Logo from "./Logo.astro";
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="feed footer__inner">
    <a class="wordmark" href="/#top">
      <Logo class="wordmark__mark" size={22} />
    </a>

    <p class="footer__sign" data-clock>
      It is <span data-time>…</span>. The best way to reach me is a
      <a href={`mailto:${profile.email}`}>quick email</a>.
      Have a lovely <span data-period>day</span>. <span aria-hidden="true">👋</span>
    </p>

    <div class="footer__social">
      <a href={profile.links.github} target="_blank" rel="noreferrer" aria-label="GitHub">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.22-3.37-1.22-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z"/></svg>
      </a>
      <a href={profile.links.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
        <svg viewBox="0 0 24 24" width="19" height="19" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.3c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9V9Z"/></svg>
      </a>
      {profile.cvUrl && (
        <a href={profile.cvUrl} download aria-label="Résumé (PDF)">
          <svg viewBox="0 0 24 24" width="18" height="18" fill="none" aria-hidden="true"><path d="M7 3h7l4 4v14H7z" stroke="currentColor" stroke-width="1.6" stroke-linejoin="round"/><path d="M14 3v4h4M9.5 13h5M9.5 16.5h5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>
        </a>
      )}
    </div>

    <nav class="footer__nav mono" aria-label="More">
      <a href="/now">Now</a>
      <a href="/uses">Uses</a>
      <a href="/writing">Writing</a>
      {profile.cvUrl && <a href={profile.cvUrl} download>Résumé</a>}
      <a href="/about">About</a>
    </nav>

    <p class="footer__copy mono">© {year} {profile.name}</p>
  </div>
</footer>

<style>
  .footer { border-top: 1px solid var(--border); padding-block: clamp(3rem, 6vw, 4.5rem) clamp(7rem, 10vw, 8rem); }
  .footer__inner { display: flex; flex-direction: column; align-items: center; gap: 1.3rem; text-align: center; }
  .wordmark { display: inline-flex; align-items: center; gap: 0.55rem; font-weight: 720; }
  .wordmark__mark { display: block; color: var(--ink); }
  .footer__sign { color: var(--muted); max-width: 46ch; line-height: 1.7; }
  .footer__sign :global(span) { color: var(--ink); font-weight: 560; }
  .footer__sign a { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }
  .footer__sign a:hover { color: var(--primary-hi); }
  .footer__social { display: inline-flex; gap: 0.4rem; }
  .footer__social a {
    display: grid; place-items: center; width: 34px; height: 34px;
    border-radius: 9px; border: 1px solid var(--border); background: var(--surface);
    color: var(--muted); transition: color 0.2s ease, border-color 0.2s ease, transform 0.2s ease;
  }
  .footer__social a svg { width: 16px; height: 16px; }
  .footer__social a:hover { color: var(--ink); border-color: var(--primary); transform: translateY(-2px); }
  .footer__nav { display: flex; flex-wrap: wrap; justify-content: center; gap: 0.4rem 1.1rem; font-size: 0.74rem; }
  .footer__nav a { color: var(--muted); transition: color 0.18s ease; }
  .footer__nav a:hover { color: var(--ink); }
  .footer__copy { font-size: 0.72rem; color: var(--faint); letter-spacing: 0.05em; }
</style>

<script>
  // live local-time sign-off
  const el = document.querySelector("[data-clock]");
  if (el) {
    const timeEl = el.querySelector("[data-time]");
    const periodEl = el.querySelector("[data-period]");
    const tick = () => {
      const now = new Date();
      const h = now.getHours();
      if (timeEl)
        timeEl.textContent = now.toLocaleTimeString([], { hour: "numeric", minute: "2-digit" });
      if (periodEl)
        periodEl.textContent = h < 12 ? "morning" : h < 18 ? "afternoon" : "evening";
    };
    tick();
    setInterval(tick, 1000 * 30);
  }
</script>
