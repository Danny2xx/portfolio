---
import { profile } from "../data/content";
---

<footer class="foot">
  <span data-clock>—— · Birmingham</span>
  <span class="foot__ico">
    <a href={profile.links.github} target="_blank" rel="noreferrer" aria-label="GitHub">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.48 2 2 6.58 2 12.25c0 4.53 2.87 8.37 6.84 9.73.5.1.68-.22.68-.49v-1.7c-2.78.62-3.37-1.22-3.37-1.22-.45-1.18-1.11-1.5-1.11-1.5-.91-.64.07-.63.07-.63 1 .07 1.53 1.06 1.53 1.06.9 1.57 2.34 1.12 2.91.85.09-.66.35-1.12.63-1.38-2.22-.26-4.56-1.14-4.56-5.07 0-1.12.39-2.03 1.03-2.75-.1-.26-.45-1.3.1-2.71 0 0 .84-.28 2.75 1.05a9.4 9.4 0 0 1 5 0c1.91-1.33 2.75-1.05 2.75-1.05.55 1.41.2 2.45.1 2.71.64.72 1.03 1.63 1.03 2.75 0 3.94-2.34 4.81-4.57 5.06.36.32.68.94.68 1.9v2.82c0 .27.18.6.69.49A10.26 10.26 0 0 0 22 12.25C22 6.58 17.52 2 12 2Z" /></svg>
    </a>
    <a href={profile.links.linkedin} target="_blank" rel="noreferrer" aria-label="LinkedIn">
      <svg width="15" height="15" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5ZM3 9h4v12H3V9Zm6 0h3.8v1.7h.05c.53-1 1.83-2.05 3.77-2.05 4.03 0 4.78 2.65 4.78 6.1V21h-4v-5.3c0-1.27-.02-2.9-1.77-2.9-1.77 0-2.04 1.38-2.04 2.8V21H9V9Z" /></svg>
    </a>
    {profile.cvUrl && (
      <a href={profile.cvUrl} target="_blank" rel="noreferrer" aria-label="Résumé (PDF)">
        <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M7 3h7l4 4v14H7z" stroke-linejoin="round" /><path d="M14 3v4h4M9.5 13h5M9.5 16.5h5" stroke-linecap="round" /></svg>
      </a>
    )}
  </span>
</footer>

<script>
  const el = document.querySelector("[data-clock]");
  if (el) {
    const tick = () => {
      const time = new Date().toLocaleTimeString("en-GB", { hour: "numeric", minute: "2-digit", timeZone: "Europe/London" });
      el.textContent = `${time} · Birmingham`;
    };
    tick();
    setInterval(tick, 30_000);
  }
</script>
