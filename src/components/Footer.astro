---
import { profile } from "../data/content";
const year = new Date().getFullYear();
---

<footer class="foot">
  <div class="wrap foot__in">
    <p>© {year} {profile.name}</p>
    <nav class="foot__nav" aria-label="Footer">
      <a href="/writing">Writing</a>
      {profile.cvUrl && <a href={profile.cvUrl} target="_blank" rel="noreferrer">Résumé</a>}
      <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub</a>
      <a href={profile.links.linkedin} target="_blank" rel="noreferrer">LinkedIn</a>
    </nav>
    <p class="foot__note">Built with Astro. No trackers, no third-party requests.</p>
  </div>
</footer>

<style>
  .foot { border-top: 1px solid var(--line); padding-block: 2.2rem calc(6.5rem + env(safe-area-inset-bottom)); }
  .foot__in {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1rem 2rem;
    font-size: 0.86rem;
    color: var(--faint);
  }
  .foot__nav { display: flex; flex-wrap: wrap; gap: 0.5rem 1.4rem; }
  .foot__nav a { color: var(--muted); transition: color 0.2s ease; }
  .foot__nav a:hover { color: var(--ink); }
</style>
