---
import { profile, heroIntro, heroSources } from "../data/content";

const esc = (s: string) => s.replace(/&/g, "&amp;").replace(/</g, "&lt;");
// "[[id]]" -> numbered citation chip pointing at its source
const withCitations = (s: string) =>
  esc(s).replace(/\s*\[\[([\w-]+)\]\]/g, (_m, id: string) => {
    const n = heroSources.findIndex((src) => src.id === id) + 1;
    if (n === 0) return "";
    return `<a class="cite" href="#src-${n}" data-cite="${n}" aria-label="Source ${n}: ${esc(heroSources[n - 1].title)}">${n}</a>`;
  });
---

<section class="hero" id="top" data-hero>
  <div class="wrap">
    <div class="hero__meta hero__fade">
      <img class="hero__avatar" src="/vector.png" alt="" width="96" height="96" />
      <div>
        <p class="hero__name">{profile.name}</p>
        <p class="hero__role">{profile.title} · {profile.location}</p>
      </div>
    </div>

    <h1 class="hero__title display">
      <span class="sr-only">{profile.headline}</span>
      <span class="hero__line" aria-hidden="true"><span>I build AI that</span></span>
      <span class="hero__line" aria-hidden="true"><span>has to <mark class="hl-mark" data-manual>work after</mark></span></span>
      <span class="hero__line" aria-hidden="true"><span><mark class="hl-mark" data-manual>the demo.</mark></span></span>
    </h1>

    <div class="hero__grid">
      <div class="hero__intro hero__fade" style="--d: 560ms">
        <p class="hero__lede" set:html={withCitations(heroIntro.lede)} />
        <p class="hero__sub" set:html={withCitations(heroIntro.sub)} />
        <div class="hero__actions">
          <a class="btn btn--hl" href="#work">See the work</a>
          <a class="btn btn--ghost" href={`mailto:${profile.email}`}>Email me</a>
        </div>
      </div>

      <aside class="sources hero__fade" style="--d: 700ms" aria-labelledby="sources-title">
        <div class="sources__head">
          <h2 class="sources__title" id="sources-title">Sources</h2>
          <p class="sources__hint">Each numbered claim links to its evidence.</p>
        </div>
        <ol class="sources__list">
          {heroSources.map((s, i) => (
            <li class="source" id={`src-${i + 1}`} data-source={i + 1}>
              <a class="source__link" href={s.href} target="_blank" rel="noreferrer">
                <span class="source__n">{i + 1}</span>
                <span class="source__body">
                  <span class="source__title">{s.title}</span>
                  <span class="source__detail">{s.detail}</span>
                </span>
                <span class="source__type">{s.type}</span>
              </a>
            </li>
          ))}
        </ol>
      </aside>
    </div>
  </div>

  <svg class="wire" aria-hidden="true" data-wire><path></path></svg>
</section>

<style>
  /* bottom padding keeps the last source and the buttons clear of the dock */
  /* bottom padding keeps the last source clear of the floating dock at rest */
  .hero { position: relative; padding-top: clamp(6.5rem, 11vw, 8.5rem); padding-bottom: clamp(7.5rem, 13vw, 10rem); }

  .hero__meta { display: flex; align-items: center; gap: 0.8rem; }
  .hero__avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 28%;
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line);
  }
  .hero__name { font-weight: 620; font-stretch: 106%; line-height: 1.3; }
  .hero__role { font-size: 0.88rem; color: var(--muted); line-height: 1.3; }

  .hero__title { margin-top: clamp(2.2rem, 5vw, 3.4rem); font-size: clamp(2.85rem, 0.8rem + 7.4vw, 6rem); }
  .hero__line { display: block; overflow: hidden; padding-block: 0.06em 0.12em; margin-block: -0.06em -0.12em; }
  .hero__line > span { display: block; }
  .hero .hl-mark { --hl-delay: 760ms; }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 3rem;
    align-items: end;
    margin-top: clamp(2.4rem, 5vw, 3.6rem);
  }
  .hero__intro { grid-column: 1 / span 6; }
  .sources { grid-column: 8 / -1; }

  .hero__lede { max-width: 38rem; font-size: clamp(1.12rem, 1rem + 0.45vw, 1.32rem); line-height: 1.55; color: var(--ink); }
  .hero__sub { max-width: 36rem; margin-top: 1rem; color: var(--muted); }
  .hero__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 2rem; }

  /* citation chips (rendered via set:html, so global) */
  .hero :global(.cite) {
    display: inline-grid;
    place-items: center;
    min-width: 1.4em;
    height: 1.4em;
    margin-left: 0.22em;
    padding: 0 0.3em;
    border-radius: 5px;
    vertical-align: 0.28em;
    font: 600 0.6em/1 var(--font-mono);
    color: var(--on-hl);
    background: var(--hl);
    transition: box-shadow 0.25s ease, transform 0.35s var(--ease-out);
  }
  .hero :global(.cite:hover),
  .hero :global(.cite.is-lit) { box-shadow: 0 0 0 4px var(--hl-soft); transform: translateY(-1px); }

  /* sources */
  .sources__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
  }
  .sources__title { font-size: 0.95rem; font-weight: 620; font-stretch: 106%; }
  .sources__hint { font-size: 0.8rem; color: var(--faint); text-align: right; }
  .sources__list { list-style: none; margin: 0; padding: 0; }
  .source__link {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.9rem;
    padding: 0.85rem 0;
    border-bottom: 1px solid var(--line);
  }
  .source__n {
    display: grid;
    place-items: center;
    width: 1.75rem;
    height: 1.75rem;
    border-radius: 6px;
    font: 500 0.78rem/1 var(--font-mono);
    color: var(--muted);
    box-shadow: inset 0 0 0 1px var(--line-strong);
    transition: background-color 0.3s ease, color 0.3s ease, box-shadow 0.3s ease;
  }
  .source__body { min-width: 0; transition: transform 0.5s var(--ease-out); }
  .source__title { display: block; font-weight: 600; line-height: 1.35; }
  .source__detail { display: block; font-size: 0.82rem; color: var(--faint); line-height: 1.35; }
  .source__type {
    padding: 0.32rem 0.55rem;
    border-radius: 999px;
    font: 500 0.7rem/1 var(--font-mono);
    color: var(--faint);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .source__link:hover .source__n,
  .source.is-lit .source__n { background: var(--hl); color: var(--on-hl); box-shadow: none; }
  .source__link:hover .source__body,
  .source.is-lit .source__body { transform: translateX(5px); }

  /* the connector drawn between a citation and its source */
  .wire {
    position: fixed;
    inset: 0;
    width: 100vw;
    height: 100vh;
    overflow: visible;
    pointer-events: none;
    z-index: var(--z-wire);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .wire.is-on { opacity: 1; }
  .wire path { fill: none; stroke: var(--hl-text); stroke-width: 1.5; stroke-linecap: round; }

  /* load choreography */
  :global(.motion) .hero__line > span { transform: translateY(112%); transition: transform 1.15s var(--ease-out); }
  :global(.motion) .hero__line:nth-child(3) > span { transition-delay: 90ms; }
  :global(.motion) .hero__line:nth-child(4) > span { transition-delay: 180ms; }
  :global(.motion) .hero.is-in .hero__line > span { transform: none; }
  :global(.motion) .hero__fade {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
    transition-delay: var(--d, 0ms);
  }
  :global(.motion) .hero.is-in .hero__fade { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .hero__intro, .sources { grid-column: 1 / -1; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) {
    const start = () => {
      hero.classList.add("is-in");
      hero.querySelectorAll(".hl-mark").forEach((m) => m.classList.add("is-in"));
    };
    if (document.documentElement.classList.contains("motion")) {
      const fonts = document.fonts?.ready ?? Promise.resolve();
      Promise.race([fonts, new Promise((r) => setTimeout(r, 700))]).then(() => requestAnimationFrame(start));
    } else start();

    const wire = hero.querySelector<SVGSVGElement>("[data-wire]")!;
    const path = wire.querySelector("path")!;
    const wide = window.matchMedia("(min-width: 901px) and (pointer: fine)");
    let active: string | null = null;

    const light = (n: string | null) => {
      hero.querySelectorAll(".cite.is-lit, .source.is-lit").forEach((el) => el.classList.remove("is-lit"));
      if (n) hero.querySelectorAll(`.cite[data-cite="${n}"], .source[data-source="${n}"]`).forEach((el) => el.classList.add("is-lit"));
    };

    const draw = (animate: boolean) => {
      if (!active || !wide.matches) return wire.classList.remove("is-on");
      const a = hero.querySelector(`.cite[data-cite="${active}"]`);
      const b = hero.querySelector(`#src-${active} .source__n`);
      if (!a || !b) return;
      const ra = a.getBoundingClientRect();
      const rb = b.getBoundingClientRect();
      const x1 = ra.right + 6, y1 = ra.top + ra.height / 2;
      const x2 = rb.left - 8, y2 = rb.top + rb.height / 2;
      const dx = Math.max(40, (x2 - x1) * 0.5);
      path.setAttribute("d", `M${x1},${y1} C${x1 + dx},${y1} ${x2 - dx},${y2} ${x2},${y2}`);
      if (animate && document.documentElement.classList.contains("motion")) {
        const len = path.getTotalLength();
        path.style.transition = "none";
        path.style.strokeDasharray = `${len}`;
        path.style.strokeDashoffset = `${len}`;
        path.getBoundingClientRect();
        path.style.transition = "stroke-dashoffset 0.6s cubic-bezier(0.16, 1, 0.3, 1)";
        path.style.strokeDashoffset = "0";
      }
      wire.classList.add("is-on");
    };

    const on = (n: string) => {
      if (n === active) return;
      active = n;
      light(n);
      draw(true);
    };
    const off = () => {
      active = null;
      light(null);
      wire.classList.remove("is-on");
    };
    const keyOf = (el: Element | null) => {
      const t = el?.closest<HTMLElement>(".cite, .source");
      return t ? (t.dataset.cite ?? t.dataset.source ?? null) : null;
    };

    hero.addEventListener("pointerover", (e) => {
      const n = keyOf(e.target as Element);
      if (n) on(n);
    });
    hero.addEventListener("pointerout", (e) => {
      const from = keyOf(e.target as Element);
      const to = keyOf(e.relatedTarget as Element | null);
      if (from && from !== to) off();
    });
    hero.addEventListener("focusin", (e) => {
      const n = keyOf(e.target as Element);
      if (n) on(n);
    });
    hero.addEventListener("focusout", off);
    window.addEventListener("scroll", () => active && draw(false), { passive: true });

    // Citation click: on desktop open the evidence; on touch, jump to it and flash.
    hero.addEventListener("click", (e) => {
      const cite = (e.target as Element).closest<HTMLAnchorElement>(".cite");
      if (!cite) return;
      const n = cite.dataset.cite!;
      if (wide.matches) {
        e.preventDefault();
        const href = hero.querySelector<HTMLAnchorElement>(`#src-${n} .source__link`)?.href;
        if (href) window.open(href, "_blank", "noopener");
        return;
      }
      light(n);
      window.setTimeout(() => active !== n && light(null), 1800);
    });
  }
</script>
