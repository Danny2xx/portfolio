---
// Report masthead. Not a landing-page hero: no call-to-action pair, no feature
// bullets. Who wrote this, what it covers, and how the claims came out.
import { profile, reportIntro, claims } from "../data/content";

const pass = claims.filter((c) => c.result === "PASS").length;
const fail = claims.filter((c) => c.result === "FAIL").length;
const untested = claims.filter((c) => c.result === "UNTESTED").length;
const systems = new Set(claims.map((c) => c.system)).size;
---

<header class="mast" id="top" data-hero>
  <div class="wrap">
    <div class="mast__who mast__fade">
      <img class="mast__portrait" src="/vector.png" alt="" width="96" height="96" />
      <p>
        <span class="mast__name">{profile.name}</span>
        <span class="mast__role">{profile.title}, {profile.location}</span>
      </p>
    </div>

    <h1 class="mast__title display">
      <span class="sr-only">What I built, and what held up</span>
      <span class="mast__line" aria-hidden="true"><span>What I built,</span></span>
      <span class="mast__line" aria-hidden="true"><span>and what <mark class="hl-mark" data-manual>held up</mark>.</span></span>
    </h1>

    <div class="mast__body">
      <p class="mast__intro mast__fade" style="--d: 480ms">{reportIntro}</p>

      <dl class="tally mast__fade" style="--d: 600ms">
        <div><dt>Systems</dt><dd>{systems}</dd></div>
        <div><dt>Claims</dt><dd>{claims.length}</dd></div>
        <div><dt>Held up</dt><dd>{pass}</dd></div>
        <div class="tally__fail"><dt>Failed</dt><dd>{fail}</dd></div>
        <div><dt>Untested</dt><dd>{untested}</dd></div>
      </dl>
    </div>
  </div>
</header>

<style>
  .mast { padding-top: clamp(6.5rem, 11vw, 8.5rem); padding-bottom: clamp(2.5rem, 5vw, 3.5rem); }

  .mast__who { display: flex; align-items: center; gap: 0.85rem; }
  .mast__portrait {
    width: 44px;
    height: 44px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 28%;
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line);
  }
  .mast__name { display: block; font-weight: 620; font-stretch: 106%; line-height: 1.3; }
  .mast__role { display: block; font-size: 0.88rem; color: var(--muted); line-height: 1.3; }

  .mast__title {
    margin-top: clamp(2rem, 4.5vw, 3rem);
    font-size: clamp(2.7rem, 0.9rem + 6.6vw, 5.5rem);
    font-stretch: 112%;
  }
  .mast__line { display: block; overflow: hidden; padding-block: 0.06em 0.12em; margin-block: -0.06em -0.12em; }
  .mast__line > span { display: block; }
  .mast .hl-mark { --hl-delay: 700ms; }

  .mast__body {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 2rem;
    align-items: end;
    margin-top: clamp(2.2rem, 5vw, 3.2rem);
  }
  .mast__intro {
    grid-column: 1 / span 6;
    max-width: 44ch;
    font-size: clamp(1.05rem, 0.98rem + 0.35vw, 1.22rem);
    line-height: 1.5;
    color: var(--muted);
  }

  .tally { grid-column: 8 / -1; display: flex; flex-wrap: wrap; gap: 1.6rem; margin: 0; }
  .tally dt { font-size: 0.78rem; color: var(--faint); }
  .tally dd {
    margin: 0.15rem 0 0;
    font: 600 1.5rem/1 var(--font-mono);
    font-variant-numeric: tabular-nums;
    color: var(--ink);
  }
  .tally__fail dd { color: var(--hl-text); }

  :global(.motion) .mast__title { font-stretch: 86%; transition: font-stretch 1.4s var(--ease-out); }
  :global(.motion) .mast.is-in .mast__title { font-stretch: 112%; }
  :global(.motion) .mast__line > span { transform: translateY(112%); transition: transform 1.1s var(--ease-out); }
  :global(.motion) .mast__line:nth-child(3) > span { transition-delay: 90ms; }
  :global(.motion) .mast.is-in .mast__line > span { transform: none; }
  :global(.motion) .mast__fade {
    opacity: 0;
    transform: translateY(16px);
    transition: opacity 0.85s var(--ease-out), transform 0.85s var(--ease-out);
    transition-delay: var(--d, 0ms);
  }
  :global(.motion) .mast.is-in .mast__fade { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .mast__intro, .tally { grid-column: 1 / -1; }
    .tally { gap: 1.2rem 1.8rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.motion) .mast__title { font-stretch: 112%; transition: none; }
  }
</style>

<script>
  const mast = document.querySelector<HTMLElement>("[data-hero]");
  if (mast) {
    const start = () => {
      mast.classList.add("is-in");
      mast.querySelectorAll(".hl-mark").forEach((m) => m.classList.add("is-in"));
    };
    if (document.documentElement.classList.contains("motion")) {
      const fonts = document.fonts?.ready ?? Promise.resolve();
      Promise.race([fonts, new Promise((r) => setTimeout(r, 700))]).then(() => requestAnimationFrame(start));
    } else start();
  }
</script>
