---
import { profile, heroLede, heroSub, heroBuilds } from "../data/content";
---

<section class="hero" id="top" data-hero>
  <div class="wrap">
    <div class="hero__meta hero__fade">
      <img class="hero__avatar" src="/vector.png" alt="" width="96" height="96" />
      <div>
        <p class="hero__name">{profile.name}</p>
        <p class="hero__role">{profile.title} · {profile.location}</p>
      </div>
    </div>

    <h1 class="hero__title display">
      <span class="sr-only">{profile.headline}</span>
      <span class="hero__line" aria-hidden="true"><span>I build AI that</span></span>
      <span class="hero__line" aria-hidden="true"><span>has to <mark class="hl-mark" data-manual>work after</mark></span></span>
      <span class="hero__line" aria-hidden="true"><span><mark class="hl-mark" data-manual>the demo.</mark></span></span>
    </h1>

    <div class="hero__grid">
      <div class="hero__intro hero__fade" style="--d: 520ms">
        <p class="hero__lede">{heroLede}</p>
        <p class="hero__sub">{heroSub}</p>
        <div class="hero__actions">
          <a class="btn btn--hl" href="#work">See the work</a>
          <a class="btn btn--ghost" href={`mailto:${profile.email}`}>Email me</a>
          <span class="hero__status"><span class="light" aria-hidden="true"></span>{profile.status}</span>
        </div>
      </div>

      <aside class="builds hero__fade" style="--d: 660ms" aria-labelledby="builds-title">
        <h2 class="builds__title" id="builds-title">Things I've built</h2>
        <ul class="builds__list">
          {heroBuilds.map((b) => (
            <li class="build">
              <a class="build__link" href={b.href}>
                <span class="build__what">{b.what}</span>
                <span class="build__proof">{b.proof}</span>
              </a>
            </li>
          ))}
        </ul>
      </aside>
    </div>
  </div>
</section>

<style>
  .hero { position: relative; padding-top: clamp(6.5rem, 11vw, 8.5rem); padding-bottom: clamp(7.5rem, 13vw, 10rem); }

  .hero__meta { display: flex; align-items: center; gap: 0.8rem; }
  .hero__avatar {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    object-fit: cover;
    object-position: center 28%;
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--line);
  }
  .hero__name { font-weight: 620; font-stretch: 106%; line-height: 1.3; }
  .hero__role { font-size: 0.88rem; color: var(--muted); line-height: 1.3; }

  .hero__title {
    margin-top: clamp(2.2rem, 5vw, 3.4rem);
    font-size: clamp(2.85rem, 0.8rem + 7.4vw, 6rem);
    font-stretch: 112%;
  }
  .hero__line { display: block; overflow: hidden; padding-block: 0.06em 0.12em; margin-block: -0.06em -0.12em; }
  .hero__line > span { display: block; }
  .hero .hl-mark { --hl-delay: 760ms; }

  .hero__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 3rem;
    align-items: start;
    margin-top: clamp(2.4rem, 5vw, 3.6rem);
  }
  .hero__intro { grid-column: 1 / span 6; }
  .builds { grid-column: 8 / -1; }

  .hero__lede {
    max-width: 34ch;
    font-size: clamp(1.18rem, 1rem + 0.6vw, 1.45rem);
    line-height: 1.45;
    letter-spacing: -0.012em;
    color: var(--ink);
    text-wrap: pretty;
  }
  .hero__sub { max-width: 44ch; margin-top: 1.1rem; color: var(--muted); }
  .hero__actions { display: flex; flex-wrap: wrap; align-items: center; gap: 0.75rem; margin-top: 2rem; }
  .hero__status { display: inline-flex; align-items: center; gap: 0.55rem; margin-left: 0.4rem; font-size: 0.85rem; color: var(--muted); }

  /* what I build, each line backed by a real system */
  .builds__title {
    padding-bottom: 0.85rem;
    border-bottom: 1px solid var(--line);
    font-size: 0.92rem;
    font-weight: 620;
  }
  .builds__list { list-style: none; margin: 0; padding: 0; }
  .build__link {
    position: relative;
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.2rem;
    padding: 0.9rem 0;
    border-bottom: 1px solid var(--line);
  }
  .build__what {
    font-size: 0.98rem;
    color: var(--ink);
    transition: transform 0.45s var(--ease-out);
  }
  .build__proof {
    flex: none;
    font-size: 0.82rem;
    color: var(--faint);
    white-space: nowrap;
    transition: color 0.25s ease;
  }
  .build__link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: -1px;
    width: 100%;
    height: 1px;
    background: var(--hl-text);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.5s var(--ease-out);
  }
  .build__link:hover .build__what { transform: translateX(6px); }
  .build__link:hover .build__proof { color: var(--hl-text); }
  .build__link:hover::after { transform: scaleX(1); }

  /* at rest the rail walks itself, so the page is never completely still */
  .build.is-live .build__proof { color: var(--hl-text); }
  .build.is-live .build__link::after { transform: scaleX(1); }

  /* load choreography: lines rise, and the type widens into place */
  :global(.motion) .hero__title { font-stretch: 86%; transition: font-stretch 1.4s var(--ease-out); }
  :global(.motion) .hero.is-in .hero__title { font-stretch: 112%; }
  :global(.motion) .hero__line > span { transform: translateY(112%); transition: transform 1.15s var(--ease-out); }
  :global(.motion) .hero__line:nth-child(3) > span { transition-delay: 90ms; }
  :global(.motion) .hero__line:nth-child(4) > span { transition-delay: 180ms; }
  :global(.motion) .hero.is-in .hero__line > span { transform: none; }
  :global(.motion) .hero__fade {
    opacity: 0;
    transform: translateY(18px);
    transition: opacity 0.9s var(--ease-out), transform 0.9s var(--ease-out);
    transition-delay: var(--d, 0ms);
  }
  :global(.motion) .hero.is-in .hero__fade { opacity: 1; transform: none; }

  @media (max-width: 900px) {
    .hero__intro, .builds { grid-column: 1 / -1; }
    .hero__lede { max-width: none; }
    /* on a phone the rail comes second, right after the lede, so what he builds
       is on the first screen. The supporting paragraph and buttons follow it. */
    .hero__grid { row-gap: 2rem; }
    .hero__intro { display: flex; flex-direction: column; }
    .hero__lede { order: 1; }
    .hero__sub { order: 3; margin-top: 1.6rem; }
    .hero__actions { order: 4; }
    .builds { order: 2; margin-top: -0.4rem; }
  }
  @media (max-width: 900px) {
    /* pull the rail up between lede and sub by flattening the two columns */
    .hero__grid { display: flex; flex-direction: column; }
    .hero__intro { display: contents; }
  }
  @media (prefers-reduced-motion: reduce) {
    :global(.motion) .hero__title { font-stretch: 112%; transition: none; }
  }
</style>

<script>
  const hero = document.querySelector<HTMLElement>("[data-hero]");
  if (hero) {
    const start = () => {
      hero.classList.add("is-in");
      hero.querySelectorAll(".hl-mark").forEach((m) => m.classList.add("is-in"));
    };
    if (document.documentElement.classList.contains("motion")) {
      const fonts = document.fonts?.ready ?? Promise.resolve();
      Promise.race([fonts, new Promise((r) => setTimeout(r, 700))]).then(() => requestAnimationFrame(start));
    } else start();

    // Walk the highlighter down the rail while it's on screen; pause on hover
    // so it never fights the pointer.
    const rail = hero.querySelector<HTMLElement>(".builds");
    const rows = Array.from(hero.querySelectorAll<HTMLElement>(".build"));
    if (rail && rows.length > 1 && document.documentElement.classList.contains("motion")) {
      let i = -1;
      let timer = 0;
      const step = () => {
        i = (i + 1) % rows.length;
        rows.forEach((row, n) => row.classList.toggle("is-live", n === i));
      };
      const play = () => { if (!timer) { step(); timer = window.setInterval(step, 2600); } };
      const pause = () => {
        window.clearInterval(timer);
        timer = 0;
        rows.forEach((row) => row.classList.remove("is-live"));
      };
      new IntersectionObserver(
        ([entry]) => (entry.isIntersecting ? play() : pause()),
        { threshold: 0.25 },
      ).observe(rail);
      rail.addEventListener("pointerenter", pause);
      rail.addEventListener("pointerleave", play);
    }
  }
</script>
