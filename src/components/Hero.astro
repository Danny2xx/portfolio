---
import { profile } from "../data/content";
import { inline } from "../lib/inline";
---

<section class="hero" id="top">
  <div class="feed">
    <div class="hero__id" data-reveal>
      <div class="avatar">
        <img src="/vector.png" alt={`Illustrated portrait of ${profile.name}`} width="96" height="96" />
      </div>
      <div class="hero__who">
        <h1 class="hero__name">
          {profile.name}
          <span class="verify" title="Verified">
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path class="verify__seal" d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81c-.66-1.31-1.91-2.19-3.34-2.19s-2.67.88-3.33 2.19c-1.4-.46-2.91-.2-3.92.81s-1.26 2.52-.8 3.91c-1.31.67-2.2 1.91-2.2 3.34s.89 2.67 2.2 3.34c-.46 1.39-.21 2.9.8 3.91s2.52 1.26 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.68-.88 3.34-2.19c1.39.45 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34z" />
              <path class="verify__check" d="M10.54 16.2 6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z" />
            </svg>
          </span>
        </h1>
        <p class="hero__role">{profile.title}<span aria-hidden="true"> · </span>{profile.location}</p>
      </div>
    </div>

    <p class="hero__statement" data-reveal>{profile.headline}</p>

    <div class="hero__bio" data-reveal>
      {profile.bio.map((p) => <p set:html={inline(p)} />)}
    </div>

    <div class="hero__actions" data-reveal>
      <a class="btn btn--solid" href={`mailto:${profile.email}`}>Email me</a>
      {profile.cvUrl && (
        <a class="btn btn--line" href={profile.cvUrl} target="_blank" rel="noreferrer">
          Résumé <span class="hero__pdf">PDF</span>
        </a>
      )}
      <span class="hero__status">
        <span class="light" aria-hidden="true"></span>
        {profile.status}
      </span>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(6rem, 11vw, 7.75rem); padding-bottom: clamp(2.2rem, 5vw, 3rem); }

  .hero__id { display: flex; align-items: center; gap: 0.8rem; }
  .avatar {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    overflow: hidden;
    position: relative;
    background: var(--surface-2);
  }
  .avatar img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 30%;
    transform: scale(1.12);
  }
  .hero__name {
    display: flex;
    align-items: center;
    gap: 0.35rem;
    font-size: 0.98rem;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .verify { display: inline-flex; flex: none; width: 0.95em; height: 0.95em; }
  .verify svg { width: 100%; height: 100%; display: block; }
  .verify__seal { fill: var(--ink); }
  .verify__check { fill: var(--bg); }
  .hero__role { color: var(--muted); font-size: 0.84rem; line-height: 1.35; }

  .hero__statement {
    margin-top: clamp(1.7rem, 4.5vw, 2.4rem);
    max-width: 17ch;
    font-size: clamp(1.8rem, 1.2rem + 2.4vw, 2.55rem);
    font-weight: 600;
    line-height: 1.06;
    letter-spacing: -0.034em;
    text-wrap: balance;
  }

  .hero__bio {
    display: flex;
    flex-direction: column;
    gap: 0.7rem;
    margin-top: 1.1rem;
    max-width: 58ch;
    color: var(--muted);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.55rem;
    margin-top: 1.6rem;
  }
  .hero__pdf { font-size: 0.72rem; font-weight: 500; color: var(--faint); }
  .hero__status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    margin-left: 0.6rem;
    font-size: 0.82rem;
    color: var(--muted);
  }

  /* availability light: a small signal lamp with a slow halo */
  .light {
    position: relative;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--primary);
  }
  .light::after {
    content: "";
    position: absolute;
    inset: -4px;
    border-radius: 50%;
    border: 1px solid var(--primary);
    opacity: 0;
    animation: halo 2.6s var(--ease-out) infinite;
  }
  @keyframes halo {
    0% { transform: scale(0.45); opacity: 0.8; }
    100% { transform: scale(1.5); opacity: 0; }
  }

  /* entrance: identity first, then the statement, then the rest */
  :global(.reveal-ready) .hero__id { transition-delay: 0ms !important; }
  :global(.reveal-ready) .hero__statement { transition-delay: 70ms !important; }
  :global(.reveal-ready) .hero__bio { transition-delay: 140ms !important; }
  :global(.reveal-ready) .hero__actions { transition-delay: 210ms !important; }

  @media (max-width: 480px) {
    .hero__status { margin-left: 0; margin-top: 0.35rem; width: 100%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .light::after { animation: none; }
  }
</style>
