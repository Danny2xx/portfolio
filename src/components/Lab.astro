---
import { labIntro } from "../data/content";
import Tokenizer from "./Tokenizer.tsx";
import TemperatureLab from "./TemperatureLab.tsx";
---

<section class="sec" id="demos" data-reveal>
  <div class="sec__head">
    <h2 class="sec__title">Lab</h2>
    <span class="sec__aside">Runs in your browser</span>
  </div>
  <p class="sec__intro">{labIntro}</p>

  <article class="demo">
    <div class="demo__head">
      <h3 class="demo__title">How a language model reads text</h3>
      <span class="demo__meta">Tokenizer</span>
    </div>
    <p class="demo__desc">
      Models see text as tokens: chunks of characters from a fixed vocabulary. Type below and
      watch cl100k_base, the tokenizer behind GPT-4, split it up.
    </p>
    <div class="demo__stage">
      <Tokenizer client:visible />
    </div>
  </article>

  <article class="demo">
    <div class="demo__head">
      <h3 class="demo__title">Sampling temperature</h3>
      <span class="demo__meta">Softmax</span>
    </div>
    <p class="demo__desc">
      Before picking its next token, a model scores every candidate. Temperature sets how
      sharply those scores become probabilities. Drag it and watch the odds tighten or spread.
    </p>
    <div class="demo__stage">
      <TemperatureLab client:visible />
    </div>
  </article>
</section>

<style>
  .demo {
    border: 1px solid var(--border);
    border-radius: 12px;
    padding: clamp(1rem, 3vw, 1.35rem);
  }
  .demo + .demo { margin-top: 1rem; }
  .demo__head { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .demo__title { font-size: 0.95rem; font-weight: 600; }
  .demo__meta { font-size: 0.78rem; color: var(--faint); white-space: nowrap; }
  .demo__desc { color: var(--muted); margin-top: 0.4rem; max-width: 60ch; }
  .demo__stage { margin-top: 1.2rem; }
</style>
