---
import { notes } from "../data/content";
---

<section class="section">
  <div class="feed">
    <div class="section__head" data-reveal>
      <span class="label">Writing</span>
    </div>

    <ul class="notes">
      {notes.map((n) => (
        <li class="note" data-reveal>
          <a class="note__link" href={n.href ?? "#"} target={n.href ? "_blank" : undefined} rel="noreferrer">
            <div class="note__top">
              <h3 class="note__title">{n.title}</h3>
              {n.date && <span class="note__date mono">{n.date}</span>}
            </div>
            <p class="note__blurb">{n.blurb}</p>
            <span class="note__go mono">read →</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .section { padding-block: clamp(3rem, 7vw, 5rem); }
  .section__head { margin-bottom: 1.6rem; }

  .notes { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .note { border-top: 1px solid var(--border); }
  .note:last-child { border-bottom: 1px solid var(--border); }
  .note__link { display: block; padding: 1.2rem 0.2rem; transition: padding-left 0.25s cubic-bezier(0.16,1,0.3,1); }
  .note__link:hover { padding-left: 0.7rem; }
  .note__top { display: flex; align-items: baseline; justify-content: space-between; gap: 1rem; }
  .note__title { font-size: 1.05rem; font-weight: 600; transition: color 0.2s ease; }
  .note__link:hover .note__title { color: var(--primary-hi); }
  .note__date { font-size: 0.72rem; color: var(--faint); }
  .note__blurb { color: var(--muted); margin-top: 0.35rem; font-size: 0.94rem; max-width: 64ch; }
  .note__go { display: inline-block; margin-top: 0.6rem; font-size: 0.74rem; color: var(--primary); }
</style>
