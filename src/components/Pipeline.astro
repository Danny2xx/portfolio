---
// A project's architecture as a live trace: steps light up in order while
// the diagram is on screen. Static and fully lit without motion.
import type { Step } from "../data/content";

interface Props {
  steps: Step[];
  size?: "sm" | "lg";
}
const { steps, size = "sm" } = Astro.props;
---

<div class:list={["pipe", `pipe--${size}`]} data-pipe>
  <span class="pipe__rail" aria-hidden="true"><span class="pipe__fill"></span></span>
  <ol class="pipe__list">
    {steps.map((s) => (
      <li class="pipe__step">
        <span class="pipe__dot" aria-hidden="true"></span>
        <span class="pipe__label">{s.label}</span>
        {s.detail && <span class="pipe__detail">{s.detail}</span>}
      </li>
    ))}
  </ol>
</div>

<style>
  .pipe { position: relative; }
  .pipe__rail {
    position: absolute;
    left: 5px;
    top: 0.6rem;
    bottom: 0.9rem;
    width: 1px;
    background: var(--line-strong);
  }
  .pipe__fill {
    position: absolute;
    inset: 0;
    background: var(--hl-text);
    transform-origin: top;
    transform: scaleY(var(--p, 1));
    transition: transform 0.8s var(--ease-in-out);
  }
  .pipe__list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.85rem; }
  .pipe__step { position: relative; padding-left: 1.65rem; }
  .pipe__dot {
    position: absolute;
    left: 0;
    top: 0.32rem;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--hl);
    box-shadow: 0 0 0 1px var(--hl);
    transition: background-color 0.4s ease, box-shadow 0.4s ease;
  }
  .pipe__label { display: block; font: 500 0.8rem/1.45 var(--font-mono); color: var(--ink); transition: color 0.4s ease; }
  .pipe__detail { display: block; font-size: 0.8rem; line-height: 1.4; color: var(--faint); }

  .pipe--lg .pipe__list { gap: 1.1rem; }
  .pipe--lg .pipe__label { font-size: 0.86rem; }
  .pipe--lg .pipe__detail { font-size: 0.86rem; }

  /* live trace (JS adds data-live) */
  .pipe[data-live] .pipe__dot { background: var(--bg-raise); box-shadow: inset 0 0 0 1px var(--line-strong); }
  .pipe[data-live] .pipe__step.is-on .pipe__dot { background: var(--hl); box-shadow: 0 0 0 1px var(--hl); }
  .pipe[data-live] .pipe__step.is-head .pipe__dot { box-shadow: 0 0 0 5px var(--hl-soft); }
  .pipe[data-live] .pipe__step.is-head .pipe__label { color: var(--hl-text); }
</style>

<script>
  if (document.documentElement.classList.contains("motion")) {
    document.querySelectorAll<HTMLElement>("[data-pipe]").forEach((pipe) => {
      const steps = Array.from(pipe.querySelectorAll<HTMLElement>(".pipe__step"));
      const n = steps.length;
      if (n < 2) return;
      let k = -1;
      let timer = 0;
      // light steps one by one, hold the finished trace, then start over
      const tick = () => {
        k = (k + 1) % (n + 3);
        const done = k >= n;
        steps.forEach((s, i) => {
          s.classList.toggle("is-on", done || i <= k);
          s.classList.toggle("is-head", i === k);
        });
        pipe.style.setProperty("--p", done ? "1" : String(k / (n - 1)));
      };
      const io = new IntersectionObserver(
        ([entry]) => {
          if (entry.isIntersecting) {
            pipe.dataset.live = "";
            if (!timer) {
              tick();
              timer = window.setInterval(tick, 800);
            }
          } else if (timer) {
            window.clearInterval(timer);
            timer = 0;
          }
        },
        { threshold: 0.35 },
      );
      io.observe(pipe);
    });
  }
</script>
