---
// Profile head: who this is, how to reach him, and the Profile / Lab switch.
// The two panels arrive as slots so this file owns the switching behaviour.
import { profile, bio } from "../data/content";
import Logo from "./Logo.astro";
import Ask from "./Ask.astro";
---

<header class="head">
  <div class="head__top rise" style="--d: 0ms">
    <img class="avatar" src="/vector.png" alt={`Portrait of ${profile.name}`} width="56" height="56" />
    <a class="brand" href="/" aria-label={`${profile.name}, home`}><Logo size={20} /></a>
  </div>

  <h1 class="who rise" style="--d: 70ms">
    {profile.name}
    <svg class="tick" viewBox="0 0 24 24" aria-label="Verified">
      <path fill="#e0b341" d="M22.25 12c0-1.43-.88-2.67-2.19-3.34.46-1.39.2-2.9-.81-3.91s-2.52-1.27-3.91-.81C14.67 2.63 13.43 1.75 12 1.75s-2.67.88-3.33 2.19c-1.4-.46-2.91-.2-3.92.81s-1.26 2.52-.8 3.91C2.64 9.33 1.75 10.57 1.75 12s.89 2.67 2.2 3.34c-.46 1.39-.21 2.9.8 3.91s2.52 1.26 3.91.81c.67 1.31 1.91 2.19 3.34 2.19s2.68-.88 3.34-2.19c1.39.45 2.9.2 3.91-.81s1.27-2.52.81-3.91c1.31-.67 2.19-1.91 2.19-3.34z" />
      <path fill="var(--bg)" d="M10.54 16.2 6.8 12.46l1.41-1.42 2.26 2.26 4.8-5.23 1.47 1.36-6.2 6.77z" />
    </svg>
  </h1>
  <p class="role rise" style="--d: 120ms">{profile.title}</p>

  <p class="status rise" style="--d: 150ms">
    <span class="status__dot" aria-hidden="true"></span>{profile.status}
    <span class="status__sep" aria-hidden="true">·</span>{profile.location}
  </p>

  <p class="bio rise" style="--d: 190ms">{bio}</p>

  <nav class="dots rise" style="--d: 250ms" aria-label="Elsewhere">
    <a href={`mailto:${profile.email}`}>Email ↗</a><span class="sep">/</span>
    <a href={profile.links.linkedin} target="_blank" rel="noreferrer">LinkedIn ↗</a><span class="sep">/</span>
    <a href={profile.links.github} target="_blank" rel="noreferrer">GitHub ↗</a>
    {profile.cvUrl && (
      <>
        <span class="sep">/</span>
        <a href={profile.cvUrl} target="_blank" rel="noreferrer">CV ↗</a>
      </>
    )}
  </nav>

  <div class="switch rise" style="--d: 310ms">
    <div class="tabs" data-tabs style="--n:4; --k:0" role="tablist" aria-label="Sections">
      <span class="tabs__pill" aria-hidden="true"></span>
      <button class="tab" type="button" role="tab" id="t-profile" aria-selected="true" aria-controls="p-profile">Profile</button>
      <button class="tab" type="button" role="tab" id="t-work" aria-selected="false" aria-controls="p-work">Work</button>
      <button class="tab" type="button" role="tab" id="t-about" aria-selected="false" aria-controls="p-about">About</button>
      <button class="tab" type="button" role="tab" id="t-lab" aria-selected="false" aria-controls="p-lab">Lab</button>
    </div>
    <button class="iconbtn copybtn" type="button" data-copy={profile.email} aria-label={`Copy email address, ${profile.email}`}>
      <svg class="ic ic--a" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true"><rect x="3" y="5" width="18" height="14" rx="2.5" /><path d="m4 7 8 6 8-6" /></svg>
      <svg class="ic ic--b" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><path d="m5 12.5 4.5 4.5L19 7" stroke-linecap="round" stroke-linejoin="round" /></svg>
    </button>
  </div>
</header>

<Ask />

<div id="p-profile" role="tabpanel" aria-labelledby="t-profile"><slot name="profile" /></div>
<div id="p-work" role="tabpanel" aria-labelledby="t-work" hidden><slot name="work" /></div>
<div id="p-about" role="tabpanel" aria-labelledby="t-about" hidden><slot name="about" /></div>
<div id="p-lab" role="tabpanel" aria-labelledby="t-lab" hidden><slot name="lab" /></div>

<style>
  .head__top { display: flex; align-items: center; justify-content: space-between; gap: 12px; }
  .brand { display: grid; place-items: center; width: 36px; height: 36px; margin-right: -8px; color: var(--dim); transition: color 0.24s ease, transform 0.5s var(--ease); }
  .brand:hover { color: var(--ink); transform: rotate(-7deg); }
  /* under the settings button on phones it reads as a stray mark, and the dock
     already carries the logo there */
  @media (max-width: 700px) { .brand { display: none; } }

  .status { display: flex; align-items: center; gap: 7px; margin-top: 8px; font-size: calc(13px * var(--ts)); color: var(--mid); }
  .status__dot { width: 6px; height: 6px; border-radius: 50%; background: #3ecf8e; flex: none; }
  .status__sep { color: var(--dim); }
  @media (prefers-reduced-motion: no-preference) {
    .status__dot { animation: breathe 2.6s ease-in-out infinite; }
    @keyframes breathe {
      0%, 100% { box-shadow: 0 0 0 0 rgba(62, 207, 142, 0.5); }
      60% { box-shadow: 0 0 0 5px rgba(62, 207, 142, 0); }
    }
  }

  /* the copy button swaps its icon for a tick, and holds it for a beat */
  .copybtn { position: relative; }
  .copybtn .ic { grid-area: 1 / 1; transition: transform 0.36s var(--ease), opacity 0.22s ease; }
  .copybtn .ic--b { opacity: 0; transform: scale(0.5) rotate(-25deg); color: #3ecf8e; }
  .copybtn.is-done .ic--a { opacity: 0; transform: scale(0.5) rotate(20deg); }
  .copybtn.is-done .ic--b { opacity: 1; transform: none; }
  .copybtn.is-done { border-color: #3ecf8e; }
</style>

<script>
  const group = document.querySelector<HTMLElement>("[data-tabs]");
  if (group) {
    const tabs = Array.from(group.querySelectorAll<HTMLButtonElement>(".tab"));
    const reduce = window.matchMedia("(prefers-reduced-motion: reduce)");

    const show = (target: HTMLButtonElement, push = true) => {
      tabs.forEach((tab, i) => {
        const on = tab === target;
        tab.setAttribute("aria-selected", String(on));
        if (on) group.style.setProperty("--k", String(i));
        const panel = document.getElementById(tab.getAttribute("aria-controls")!);
        if (!panel) return;
        panel.hidden = !on;
        if (on && !reduce.matches) {
          panel.classList.remove("is-swapping");
          void panel.offsetWidth;
          panel.classList.add("is-swapping");
        }
      });
      const name = target.id.replace("t-", "");
      group.dataset.on = name;
      if (push) { try { history.replaceState(null, "", `#${name}`); } catch {} }
    };

    // Ask uses this to jump to the panel holding the row it just cited.
    (window as any).__showPanel = (panelId: string) => {
      const tab = tabs.find((t) => t.getAttribute("aria-controls") === panelId);
      if (!tab || tab.getAttribute("aria-selected") === "true") return false;
      show(tab);
      return true;
    };

    for (const tab of tabs) {
      tab.addEventListener("click", () => {
        if (tab.getAttribute("aria-selected") === "true") return;
        show(tab);
      });
    }

    // a tablist should answer to the arrow keys
    group.addEventListener("keydown", (e) => {
      const i = tabs.indexOf(document.activeElement as HTMLButtonElement);
      if (i < 0) return;
      let j = -1;
      if (e.key === "ArrowRight") j = (i + 1) % tabs.length;
      else if (e.key === "ArrowLeft") j = (i - 1 + tabs.length) % tabs.length;
      if (j < 0) return;
      e.preventDefault();
      tabs[j].focus();
      tabs[j].click();
    });

    const fromHash = tabs.find((t) => `#${t.id.replace("t-", "")}` === location.hash);
    if (fromHash) show(fromHash, false);
  }

  // copy the address rather than firing a mail client that may not exist
  const copy = document.querySelector<HTMLButtonElement>("[data-copy]");
  if (copy) {
    let hold = 0;
    copy.addEventListener("click", async () => {
      const address = copy.dataset.copy!;
      try {
        await navigator.clipboard.writeText(address);
      } catch {
        window.location.href = `mailto:${address}`;
        return;
      }
      copy.classList.add("is-done");
      copy.setAttribute("aria-label", "Email address copied");
      window.clearTimeout(hold);
      hold = window.setTimeout(() => {
        copy.classList.remove("is-done");
        copy.setAttribute("aria-label", `Copy email address, ${address}`);
      }, 1800);
    });
  }
</script>
