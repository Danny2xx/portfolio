---
interface Props {
  title: string;
  desc?: string;
}
const { title, desc } = Astro.props;
---

<header class="shead">
  <h2 class="shead__title display" data-split><span class="mask"><span>{title}</span></span></h2>
  {desc && <p class="shead__desc" data-reveal>{desc}</p>}
</header>

<style>
  .shead {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    row-gap: 1.1rem;
    align-items: end;
    margin-bottom: clamp(2.8rem, 6vw, 4.8rem);
  }
  .shead__title { grid-column: 1 / span 8; font-size: clamp(2.5rem, 1.25rem + 4.6vw, 5.25rem); }
  .shead__desc { grid-column: 9 / -1; max-width: 36ch; padding-bottom: 0.6rem; color: var(--muted); font-size: 1rem; }
  .shead__desc { --d: 150ms; }
  @media (max-width: 860px) {
    .shead__title, .shead__desc { grid-column: 1 / -1; }
    .shead__desc { padding-bottom: 0; }
  }
</style>
