---
// Accessibility controls. Anchored popover on desktop, bottom sheet within
// thumb reach on phones. Settings persist to localStorage and are applied
// pre-paint in Base.astro.
---

<div class="set">
  <button
    id="set-btn"
    class="set__btn"
    type="button"
    aria-label="Accessibility settings"
    aria-expanded="false"
    aria-controls="set-panel"
  >
    <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M4 7h11M4 12h7M4 17h13" stroke-linecap="round" />
      <circle cx="19" cy="7" r="2.3" />
      <circle cx="15" cy="12" r="2.3" />
      <circle cx="9" cy="17" r="2.3" />
    </svg>
  </button>

  <div class="set__scrim" data-scrim hidden></div>

  <div id="set-panel" class="set__panel" role="dialog" aria-label="Accessibility settings" hidden>
    <div class="set__head">
      <h2 class="set__title">Accessibility</h2>
      <button class="set__close" type="button" data-close aria-label="Close accessibility settings">
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true">
          <path d="m7 7 10 10M17 7 7 17" stroke-linecap="round" />
        </svg>
      </button>
    </div>

    <div class="set__row">
      <span class="set__name">Text size</span>
      <div class="set__size">
        <button class="set__sz" data-ts="-" type="button" aria-label="Decrease text size">A<span aria-hidden="true">−</span></button>
        <span class="set__szval" data-tsval>100%</span>
        <button class="set__sz" data-ts="+" type="button" aria-label="Increase text size">A<span aria-hidden="true">+</span></button>
      </div>
    </div>

    <div class="set__row">
      <span class="set__name">High contrast</span>
      <button class="sw" data-toggle="contrast" role="switch" aria-checked="false" aria-label="High contrast"><span class="sw__dot"></span></button>
    </div>

    <div class="set__row">
      <span class="set__name">Dyslexia-friendly font</span>
      <button class="sw" data-toggle="font" role="switch" aria-checked="false" aria-label="Dyslexia-friendly font"><span class="sw__dot"></span></button>
    </div>

    <div class="set__row">
      <span class="set__name">Reduce motion</span>
      <button class="sw" data-toggle="motion" role="switch" aria-checked="false" aria-label="Reduce motion"><span class="sw__dot"></span></button>
    </div>

    <button class="set__reset" data-reset type="button">Reset to defaults</button>
  </div>
</div>

<style>
  .set { position: relative; display: inline-flex; }

  .set__btn {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: transparent;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease, background-color 0.2s ease;
  }
  .set__btn:hover { color: var(--ink); border-color: var(--line-strong); }
  .set__btn[aria-expanded="true"] { color: var(--on-hl); background: var(--hl); border-color: var(--hl); }

  .set__scrim { display: none; }

  .set__panel {
    position: absolute;
    top: calc(100% + 12px);
    right: 0;
    z-index: var(--z-dialog);
    width: 310px;
    padding: 0.4rem 1.1rem 1.1rem;
    border: 1px solid var(--line-strong);
    border-radius: 18px;
    background: var(--bg-raise);
    box-shadow: var(--shadow-lg);
  }
  .set__panel[hidden] { display: none; }

  .set__head { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding-block: 0.6rem 0.4rem; }
  .set__title { font-size: 0.95rem; font-weight: 640; }
  .set__close {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    margin-right: -0.55rem;
    border: 0;
    border-radius: 12px;
    background: none;
    color: var(--muted);
    cursor: pointer;
    transition: color 0.2s ease, background-color 0.2s ease;
  }
  .set__close:hover { color: var(--ink); background: var(--surface-2); }

  .set__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 52px;
    border-top: 1px solid var(--line);
  }
  .set__name { font-size: 0.95rem; color: var(--ink); }

  .set__size { display: inline-flex; align-items: center; gap: 0.25rem; }
  .set__sz {
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: transparent;
    color: var(--ink);
    font: inherit;
    font-size: 0.9rem;
    cursor: pointer;
    transition: border-color 0.18s ease, background-color 0.18s ease;
  }
  .set__sz:hover { border-color: var(--hl-text); background: var(--surface-2); }
  .set__szval { min-width: 3.4ch; text-align: center; font-size: 0.85rem; color: var(--muted); font-variant-numeric: tabular-nums; }

  /* switch: 52x32 with a 44px tall hit area */
  .sw {
    position: relative;
    width: 52px;
    height: 32px;
    padding: 0;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface-2);
    cursor: pointer;
    transition: background-color 0.25s ease, border-color 0.25s ease;
  }
  .sw::after { content: ""; position: absolute; inset: -6px; }
  .sw__dot {
    position: absolute;
    top: 3px;
    left: 3px;
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--faint);
    transition: transform 0.28s var(--ease-out), background-color 0.25s ease;
  }
  .sw[aria-checked="true"] { background: var(--hl); border-color: var(--hl); }
  .sw[aria-checked="true"] .sw__dot { transform: translateX(20px); background: var(--on-hl); }

  .set__reset {
    width: 100%;
    min-height: 44px;
    margin-top: 0.9rem;
    border: 1px solid var(--line-strong);
    border-radius: 12px;
    background: transparent;
    color: var(--muted);
    font: inherit;
    font-size: 0.88rem;
    cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .set__reset:hover { color: var(--ink); border-color: var(--ink); }

  /* phones: a sheet in thumb reach, above the dock, with a scrim */
  @media (max-width: 700px) {
    .set__panel {
      position: fixed;
      inset: auto 0.75rem calc(5.75rem + env(safe-area-inset-bottom)) 0.75rem;
      width: auto;
      border-radius: 22px;
      padding-bottom: 1.25rem;
    }
    .set__scrim {
      display: block;
      position: fixed;
      inset: 0;
      z-index: var(--z-dialog-backdrop, 300);
      background: oklch(0 0 0 / 0.45);
    }
    .set__scrim[hidden] { display: none; }
  }
</style>

<script>
  const btn = document.getElementById("set-btn")!;
  const panel = document.getElementById("set-panel")!;
  const scrim = document.querySelector<HTMLElement>("[data-scrim]")!;
  const root = document.documentElement;
  const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
  const del = (k: string) => { try { localStorage.removeItem(k); } catch {} };

  function open(show: boolean) {
    panel.hidden = !show;
    scrim.hidden = !show;
    btn.setAttribute("aria-expanded", String(show));
    if (show) panel.querySelector<HTMLButtonElement>("[data-close]")?.focus();
    else btn.focus();
  }

  btn.addEventListener("click", (e) => { e.stopPropagation(); open(panel.hidden); });
  panel.querySelector("[data-close]")?.addEventListener("click", () => open(false));
  scrim.addEventListener("click", () => open(false));
  document.addEventListener("click", (e) => {
    const t = e.target as Node;
    if (!panel.hidden && !panel.contains(t) && t !== btn && !btn.contains(t)) open(false);
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) open(false); });

  function sync() {
    panel.querySelectorAll<HTMLButtonElement>(".sw[data-toggle]").forEach((sw) => {
      const key = "a11y-" + sw.dataset.toggle;
      const on =
        (sw.dataset.toggle === "contrast" && get(key) === "high") ||
        (sw.dataset.toggle === "font" && get(key) === "dyslexic") ||
        (sw.dataset.toggle === "motion" && get(key) === "reduced");
      sw.setAttribute("aria-checked", String(on));
    });
    const ts = parseFloat(get("a11y-textscale") || "1");
    panel.querySelector("[data-tsval]")!.textContent = Math.round(ts * 100) + "%";
  }

  const valueFor = (t: string) => (t === "contrast" ? "high" : t === "font" ? "dyslexic" : "reduced");

  panel.querySelectorAll<HTMLButtonElement>(".sw[data-toggle]").forEach((sw) => {
    sw.addEventListener("click", () => {
      const t = sw.dataset.toggle!;
      const key = "a11y-" + t;
      const on = sw.getAttribute("aria-checked") === "true";
      if (on) { del(key); delete root.dataset[t]; }
      else { set(key, valueFor(t)); root.dataset[t] = valueFor(t); }
      sync();
    });
  });

  panel.querySelectorAll<HTMLButtonElement>("[data-ts]").forEach((b) => {
    b.addEventListener("click", () => {
      let ts = parseFloat(get("a11y-textscale") || "1");
      ts += b.dataset.ts === "+" ? 0.1 : -0.1;
      ts = Math.min(1.3, Math.max(0.85, Math.round(ts * 100) / 100));
      set("a11y-textscale", String(ts));
      root.style.setProperty("--ts", String(ts));
      sync();
    });
  });

  panel.querySelector("[data-reset]")!.addEventListener("click", () => {
    ["a11y-contrast", "a11y-font", "a11y-motion", "a11y-textscale"].forEach(del);
    delete root.dataset.contrast; delete root.dataset.font; delete root.dataset.motion;
    root.style.removeProperty("--ts");
    sync();
  });

  sync();
</script>
