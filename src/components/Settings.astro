---
// Accessibility control panel (gear button in the nav). Settings persist to
// localStorage and are applied pre-paint in Base.astro.
---

<div class="set">
  <button id="set-btn" class="set__btn" type="button" aria-label="Accessibility settings" aria-expanded="false" aria-controls="set-panel">
    <svg viewBox="0 0 24 24" width="15" height="15" fill="none" aria-hidden="true">
      <path d="M4 6h10M4 12h7M4 18h13" stroke="currentColor" stroke-width="1.7" stroke-linecap="round"/>
      <circle cx="18" cy="6" r="2.2" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="14" cy="12" r="2.2" stroke="currentColor" stroke-width="1.7"/>
      <circle cx="9" cy="18" r="2.2" stroke="currentColor" stroke-width="1.7"/>
    </svg>
  </button>

  <div id="set-panel" class="set__panel" role="dialog" aria-label="Accessibility settings" hidden>
    <div class="set__head">
      <span class="label">Accessibility</span>
      <button class="set__reset mono" data-reset type="button">reset</button>
    </div>

    <div class="set__row">
      <span class="set__name">Text size</span>
      <div class="set__size">
        <button class="set__sz" data-ts="-" type="button" aria-label="Decrease text size">A−</button>
        <span class="set__szval mono" data-tsval>100%</span>
        <button class="set__sz" data-ts="+" type="button" aria-label="Increase text size">A+</button>
      </div>
    </div>

    <div class="set__row">
      <span class="set__name">High contrast</span>
      <button class="sw" data-toggle="contrast" role="switch" aria-checked="false" aria-label="High contrast"><span class="sw__dot"></span></button>
    </div>

    <div class="set__row">
      <span class="set__name">Dyslexia-friendly font</span>
      <button class="sw" data-toggle="font" role="switch" aria-checked="false" aria-label="Dyslexia-friendly font"><span class="sw__dot"></span></button>
    </div>

    <div class="set__row">
      <span class="set__name">Reduce motion</span>
      <button class="sw" data-toggle="motion" role="switch" aria-checked="false" aria-label="Reduce motion"><span class="sw__dot"></span></button>
    </div>
  </div>
</div>

<style>
  .set { position: relative; display: inline-flex; }
  .set__btn {
    display: grid; place-items: center; width: 32px; height: 32px;
    border-radius: 9px; border: 1px solid var(--border); background: var(--surface);
    color: var(--muted); cursor: pointer;
    transition: color 0.2s ease, border-color 0.2s ease;
  }
  .set__btn:hover, .set__btn[aria-expanded="true"] { color: var(--ink); border-color: var(--border-strong); }

  .set__panel {
    position: absolute;
    top: calc(100% + 10px);
    right: 0;
    width: 270px;
    z-index: var(--z-dialog);
    background: var(--surface);
    border: 1px solid var(--border-strong);
    border-radius: 14px;
    padding: 0.9rem 1rem 1rem;
    box-shadow: 0 24px 60px -34px oklch(0 0 0 / 0.4);
    display: flex; flex-direction: column; gap: 0.2rem;
  }
  .set__panel[hidden] { display: none; }

  .set__head { display: flex; align-items: center; justify-content: space-between; margin-bottom: 0.6rem; }
  .set__reset {
    font-size: 0.7rem; color: var(--muted); background: none; border: 0; cursor: pointer;
    text-transform: uppercase; letter-spacing: 0.08em;
  }
  .set__reset:hover { color: var(--ink); }

  .set__row { display: flex; align-items: center; justify-content: space-between; gap: 1rem; padding: 0.5rem 0; }
  .set__name { font-size: 0.9rem; color: var(--ink); }

  .set__size { display: inline-flex; align-items: center; gap: 0.5rem; }
  .set__sz {
    width: 30px; height: 28px; border-radius: 7px; border: 1px solid var(--border);
    background: var(--bg); color: var(--ink); cursor: pointer; font-size: 0.8rem;
    transition: border-color 0.18s ease;
  }
  .set__sz:hover { border-color: var(--primary); }
  .set__szval { font-size: 0.72rem; color: var(--muted); width: 3ch; text-align: center; }

  /* switch */
  .sw {
    width: 40px; height: 23px; border-radius: 99px; border: 1px solid var(--border-strong);
    background: var(--surface-2); cursor: pointer; position: relative; padding: 0;
    transition: background 0.2s ease, border-color 0.2s ease;
  }
  .sw__dot {
    position: absolute; top: 2px; left: 2px; width: 17px; height: 17px; border-radius: 50%;
    background: var(--faint); transition: transform 0.2s cubic-bezier(0.16,1,0.3,1), background 0.2s ease;
  }
  .sw[aria-checked="true"] { background: var(--primary); border-color: var(--primary); }
  .sw[aria-checked="true"] .sw__dot { transform: translateX(17px); background: var(--on-primary); }

  @media (max-width: 480px) {
    .set__panel { position: fixed; top: 60px; right: 0.8rem; left: 0.8rem; width: auto; }
  }
</style>

<script>
  const btn = document.getElementById("set-btn")!;
  const panel = document.getElementById("set-panel")!;
  const root = document.documentElement;
  const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
  const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
  const del = (k: string) => { try { localStorage.removeItem(k); } catch {} };

  function open(o: boolean) {
    panel.hidden = !o;
    btn.setAttribute("aria-expanded", String(o));
  }
  btn.addEventListener("click", (e) => { e.stopPropagation(); open(panel.hidden); });
  document.addEventListener("click", (e) => {
    if (!panel.hidden && !panel.contains(e.target as Node) && e.target !== btn && !btn.contains(e.target as Node)) open(false);
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) open(false); });

  // reflect current state into the controls
  function sync() {
    panel.querySelectorAll<HTMLButtonElement>(".sw[data-toggle]").forEach((sw) => {
      const key = "a11y-" + sw.dataset.toggle;
      const on =
        (sw.dataset.toggle === "contrast" && get(key) === "high") ||
        (sw.dataset.toggle === "font" && get(key) === "dyslexic") ||
        (sw.dataset.toggle === "motion" && get(key) === "reduced");
      sw.setAttribute("aria-checked", String(on));
    });
    const ts = parseFloat(get("a11y-textscale") || "1");
    panel.querySelector("[data-tsval]")!.textContent = Math.round(ts * 100) + "%";
  }

  const valueFor = (t: string) => (t === "contrast" ? "high" : t === "font" ? "dyslexic" : "reduced");
  const attrFor = (t: string) => (t === "contrast" ? "contrast" : t === "font" ? "font" : "motion");

  panel.querySelectorAll<HTMLButtonElement>(".sw[data-toggle]").forEach((sw) => {
    sw.addEventListener("click", () => {
      const t = sw.dataset.toggle!;
      const key = "a11y-" + t;
      const on = sw.getAttribute("aria-checked") === "true";
      if (on) { del(key); delete root.dataset[attrFor(t)]; }
      else { set(key, valueFor(t)); root.dataset[attrFor(t)] = valueFor(t); }
      sync();
    });
  });

  panel.querySelectorAll<HTMLButtonElement>("[data-ts]").forEach((b) => {
    b.addEventListener("click", () => {
      let ts = parseFloat(get("a11y-textscale") || "1");
      ts += b.dataset.ts === "+" ? 0.1 : -0.1;
      ts = Math.min(1.3, Math.max(0.85, Math.round(ts * 100) / 100));
      set("a11y-textscale", String(ts));
      root.style.setProperty("--ts", String(ts));
      sync();
    });
  });

  panel.querySelector("[data-reset]")!.addEventListener("click", () => {
    ["a11y-contrast", "a11y-font", "a11y-motion", "a11y-textscale"].forEach(del);
    delete root.dataset.contrast; delete root.dataset.font; delete root.dataset.motion;
    root.style.removeProperty("--ts");
    sync();
  });

  sync();
</script>
