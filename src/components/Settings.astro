---
// Accessibility controls, behind the sliders button in the corner.
// Choices persist to localStorage and are applied pre-paint in Base.astro.
---

<div class="set">
  <button id="set-btn" class="set__btn" type="button" aria-label="Accessibility settings" aria-expanded="false" aria-controls="set-panel">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
      <path d="M4 7h11M4 12h7M4 17h13" stroke-linecap="round" />
      <circle cx="19" cy="7" r="2.3" /><circle cx="15" cy="12" r="2.3" /><circle cx="9" cy="17" r="2.3" />
    </svg>
  </button>

  <div class="set__scrim" data-scrim hidden></div>

  <div id="set-panel" class="set__panel" role="dialog" aria-label="Accessibility settings" hidden>
    <div class="set__head">
      <h2 class="set__title">Accessibility</h2>
      <button class="set__close" type="button" data-close aria-label="Close">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="m7 7 10 10M17 7 7 17" stroke-linecap="round" /></svg>
      </button>
    </div>

    <div class="set__row">
      <span>Text size</span>
      <span class="set__size">
        <button class="set__sz" type="button" data-ts="-" aria-label="Decrease text size">A−</button>
        <span class="set__val mono tnum" data-tsval>100%</span>
        <button class="set__sz" type="button" data-ts="+" aria-label="Increase text size">A+</button>
      </span>
    </div>
    <div class="set__row"><span>High contrast</span><button class="sw" type="button" role="switch" aria-checked="false" data-toggle="contrast"><span class="sw__dot"></span></button></div>
    <div class="set__row"><span>Dyslexia-friendly font</span><button class="sw" type="button" role="switch" aria-checked="false" data-toggle="font"><span class="sw__dot"></span></button></div>
    <div class="set__row"><span>Reduce motion</span><button class="sw" type="button" role="switch" aria-checked="false" data-toggle="motion"><span class="sw__dot"></span></button></div>

    <button class="set__reset" type="button" data-reset>Reset to defaults</button>
  </div>
</div>

<style>
  .set { position: fixed; top: calc(16px + env(safe-area-inset-top, 0px)); right: 16px; z-index: var(--z-panel); }
  .set__btn {
    width: 44px; height: 44px; display: grid; place-items: center;
    border: 1px solid var(--line); border-radius: 12px; background: var(--card);
    color: var(--mid); cursor: pointer; transition: color 0.18s ease, border-color 0.18s ease;
  }
  .set__btn:hover { color: var(--ink); border-color: var(--line-strong); }
  .set__btn[aria-expanded="true"] { color: var(--ink); border-color: var(--line-strong); }

  .set__scrim { display: none; }
  .set__panel {
    position: absolute; top: calc(100% + 10px); right: 0; width: 290px;
    padding: 4px 14px 14px; border: 1px solid var(--line-strong); border-radius: 16px;
    background: var(--raise); box-shadow: 0 18px 44px rgba(0, 0, 0, 0.4);
  }
  .set__panel[hidden], .set__scrim[hidden] { display: none; }

  .set__head { display: flex; align-items: center; justify-content: space-between; padding-block: 10px 6px; }
  .set__title { font-size: calc(14px * var(--ts)); font-weight: 600; }
  .set__close { width: 40px; height: 40px; margin-right: -8px; display: grid; place-items: center; border: 0; border-radius: 10px; background: none; color: var(--mid); cursor: pointer; }
  .set__close:hover { color: var(--ink); background: var(--card); }

  .set__row { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 48px; border-top: 1px solid var(--line); }
  .set__size { display: inline-flex; align-items: center; gap: 4px; }
  .set__sz { width: 40px; height: 40px; border: 1px solid var(--line); border-radius: 10px; background: none; color: var(--ink); font: inherit; cursor: pointer; }
  .set__sz:hover { border-color: var(--line-strong); }
  .set__val { min-width: 4ch; text-align: center; font-size: calc(12px * var(--ts)); color: var(--mid); }

  .sw { position: relative; width: 48px; height: 28px; padding: 0; border: 1px solid var(--line-strong); border-radius: 999px; background: var(--card); cursor: pointer; transition: background-color 0.24s ease, border-color 0.24s ease; }
  .sw::after { content: ""; position: absolute; inset: -8px; }
  .sw__dot { position: absolute; top: 3px; left: 3px; width: 20px; height: 20px; border-radius: 50%; background: var(--dim); transition: transform 0.26s var(--ease), background-color 0.24s ease; }
  .sw[aria-checked="true"] { background: var(--accent); border-color: var(--accent); }
  .sw[aria-checked="true"] .sw__dot { transform: translateX(20px); background: var(--on-accent); }

  .set__reset { width: 100%; min-height: 40px; margin-top: 12px; border: 1px solid var(--line); border-radius: 10px; background: none; color: var(--mid); font: inherit; font-size: calc(13px * var(--ts)); cursor: pointer; }
  .set__reset:hover { color: var(--ink); border-color: var(--line-strong); }

  @media (max-width: 700px) {
    .set__panel { position: fixed; inset: auto 12px calc(72px + env(safe-area-inset-bottom, 0px)) 12px; width: auto; }
    .set__scrim { display: block; position: fixed; inset: 0; background: rgba(0, 0, 0, 0.5); }
  }
</style>

<script>
  const btn = document.getElementById("set-btn");
  const panel = document.getElementById("set-panel");
  const scrim = document.querySelector<HTMLElement>("[data-scrim]");
  const root = document.documentElement;

  if (btn && panel && scrim) {
    const get = (k: string) => { try { return localStorage.getItem(k); } catch { return null; } };
    const set = (k: string, v: string) => { try { localStorage.setItem(k, v); } catch {} };
    const del = (k: string) => { try { localStorage.removeItem(k); } catch {} };

    const open = (show: boolean) => {
      panel.hidden = !show;
      scrim.hidden = !show;
      btn.setAttribute("aria-expanded", String(show));
      if (show) panel.querySelector<HTMLButtonElement>("[data-close]")?.focus();
      else btn.focus();
    };

    btn.addEventListener("click", (e) => { e.stopPropagation(); open(panel.hidden); });
    panel.querySelector("[data-close]")?.addEventListener("click", () => open(false));
    scrim.addEventListener("click", () => open(false));
    document.addEventListener("click", (e) => {
      const t = e.target as Node;
      if (!panel.hidden && !panel.contains(t) && t !== btn && !btn.contains(t)) open(false);
    });
    document.addEventListener("keydown", (e) => { if (e.key === "Escape" && !panel.hidden) open(false); });

    const sync = () => {
      panel.querySelectorAll<HTMLButtonElement>(".sw[data-toggle]").forEach((sw) => {
        const key = "a11y-" + sw.dataset.toggle;
        const on =
          (sw.dataset.toggle === "contrast" && get(key) === "high") ||
          (sw.dataset.toggle === "font" && get(key) === "dyslexic") ||
          (sw.dataset.toggle === "motion" && get(key) === "reduced");
        sw.setAttribute("aria-checked", String(on));
      });
      const ts = parseFloat(get("a11y-textscale") || "1");
      panel.querySelector("[data-tsval]")!.textContent = Math.round(ts * 100) + "%";
    };

    const valueFor = (t: string) => (t === "contrast" ? "high" : t === "font" ? "dyslexic" : "reduced");

    panel.querySelectorAll<HTMLButtonElement>(".sw[data-toggle]").forEach((sw) => {
      sw.addEventListener("click", () => {
        const t = sw.dataset.toggle!;
        const key = "a11y-" + t;
        if (sw.getAttribute("aria-checked") === "true") { del(key); delete root.dataset[t]; }
        else { set(key, valueFor(t)); root.dataset[t] = valueFor(t); }
        sync();
      });
    });

    panel.querySelectorAll<HTMLButtonElement>("[data-ts]").forEach((b) => {
      b.addEventListener("click", () => {
        let ts = parseFloat(get("a11y-textscale") || "1");
        ts = Math.min(1.3, Math.max(0.85, Math.round((ts + (b.dataset.ts === "+" ? 0.1 : -0.1)) * 100) / 100));
        set("a11y-textscale", String(ts));
        root.style.setProperty("--ts", String(ts));
        sync();
      });
    });

    panel.querySelector("[data-reset]")?.addEventListener("click", () => {
      ["a11y-contrast", "a11y-font", "a11y-motion", "a11y-textscale"].forEach(del);
      delete root.dataset.contrast; delete root.dataset.font; delete root.dataset.motion;
      root.style.removeProperty("--ts");
      sync();
    });

    sync();
  }
</script>
