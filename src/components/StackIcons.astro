---
import * as si from "simple-icons";

// Grouped by what the tools are for, so it reads as a toolkit, not a logo wall.
const groups: { label: string; items: { key: string; label: string }[] }[] = [
  {
    label: "Models and data",
    items: [
      { key: "siPython", label: "Python" },
      { key: "siPytorch", label: "PyTorch" },
      { key: "siTensorflow", label: "TensorFlow" },
      { key: "siScikitlearn", label: "scikit-learn" },
      { key: "siPandas", label: "pandas" },
      { key: "siNumpy", label: "NumPy" },
      { key: "siHuggingface", label: "Hugging Face" },
      { key: "siLangchain", label: "LangChain" },
      { key: "siOllama", label: "Ollama" },
    ],
  },
  {
    label: "Product and infra",
    items: [
      { key: "siTypescript", label: "TypeScript" },
      { key: "siReact", label: "React" },
      { key: "siNextdotjs", label: "Next.js" },
      { key: "siFastapi", label: "FastAPI" },
      { key: "siPostgresql", label: "Postgres" },
      { key: "siSupabase", label: "Supabase" },
      { key: "siDocker", label: "Docker" },
      { key: "siGithubactions", label: "GitHub Actions" },
      { key: "siVercel", label: "Vercel" },
    ],
  },
];

// relative luminance: very dark brand colours fall back to ink so they stay visible
function lum(hex: string) {
  const h = hex.replace("#", "");
  const c = [0, 2, 4].map((i) => parseInt(h.slice(i, i + 2), 16) / 255);
  const f = (v: number) => (v <= 0.03928 ? v / 12.92 : ((v + 0.055) / 1.055) ** 2.4);
  return 0.2126 * f(c[0]) + 0.7152 * f(c[1]) + 0.0722 * f(c[2]);
}

type Icon = { label: string; path: string; color: string };
const resolved = groups.map((g) => ({
  label: g.label,
  icons: g.items
    .map((it): Icon | null => {
      const ic = (si as Record<string, any>)[it.key];
      if (!ic) return null;
      const hex = "#" + ic.hex;
      return { label: it.label, path: ic.path, color: lum(hex) < 0.2 ? "var(--ink)" : hex };
    })
    .filter((x): x is Icon => x !== null),
}));
---

<div class="stk">
  {resolved.map((g) => (
    <div class="stk__group">
      <h3 class="stk__label">{g.label}</h3>
      <ul class="stk__list" role="list">
        {g.icons.map((ic) => (
          <li class="stk__item" style={`--c:${ic.color}`} data-bloom>
            <svg viewBox="0 0 24 24" width="14" height="14" aria-hidden="true"><path d={ic.path} /></svg>
            <span>{ic.label}</span>
          </li>
        ))}
      </ul>
    </div>
  ))}
</div>

<style>
  .stk { display: flex; flex-direction: column; gap: 1.1rem; }
  .stk__group { display: grid; grid-template-columns: 8.25rem 1fr; gap: 1.25rem; align-items: baseline; }
  .stk__label { font-size: 0.8rem; font-weight: 400; color: var(--faint); }
  .stk__list { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.5rem 1.15rem; }
  .stk__item { display: inline-flex; align-items: center; gap: 0.42rem; font-size: 0.86rem; color: var(--ink); }
  .stk__item svg {
    flex: none;
    fill: var(--faint);
    transform: translateY(0.02em);
    transition: fill 0.3s ease, transform 0.3s var(--ease-out);
  }
  @media (hover: hover) {
    .stk__item:hover svg { fill: var(--c); transform: translateY(-1px) scale(1.12); }
  }
  /* touch: icons take their brand colour as they scroll into view (see script) */
  .stk__item.is-bloom svg { fill: var(--c); }
  @media (max-width: 560px) {
    .stk__group { grid-template-columns: 1fr; gap: 0.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .stk__item svg { transition: none; }
  }
</style>

<script>
  if (window.matchMedia("(hover: none)").matches) {
    const io = new IntersectionObserver(
      (entries) => {
        for (const e of entries) {
          if (e.isIntersecting) {
            (e.target as HTMLElement).classList.add("is-bloom");
            io.unobserve(e.target);
          }
        }
      },
      { threshold: 0.6 },
    );
    document.querySelectorAll<HTMLElement>(".stk__item[data-bloom]").forEach((el, i) => {
      (el.querySelector("svg") as SVGElement | null)?.style.setProperty("transition-delay", `${Math.min(i * 30, 300)}ms`);
      io.observe(el);
    });
  }
</script>
