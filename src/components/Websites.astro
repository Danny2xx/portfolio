---
import { websites } from "../data/content";
---

<section class="showcase" aria-labelledby="websites-title">
  <div class="showcase__head" data-reveal>
    <h2 class="label" id="websites-title">Websites I’ve shipped</h2>
    <span class="showcase__status mono">live · {websites.length} builds</span>
  </div>

  <div class="sites">
    {websites.map((site) => (
      <article class="site" data-reveal>
        <div class="site__copy">
          <div class="site__title">
            <div>
              <h3 class="site__name">{site.name}</h3>
              <span class="site__kind mono">{site.kind}</span>
            </div>
          </div>
          <a
            class="site__link mono"
            href={site.url}
            target="_blank"
            rel="noreferrer"
            aria-label={`Visit ${site.name}`}
          >
            visit ↗
          </a>
        </div>

        <p class="site__blurb">{site.blurb}</p>

        <a
          class="site__visual"
          href={site.url}
          target="_blank"
          rel="noreferrer"
          aria-label={`Open the ${site.name} website`}
        >
          <img
            src={site.image}
            alt={site.alt}
            loading="lazy"
            width="1400"
            height="800"
          />
          <span class="site__visit mono">Visit site <span aria-hidden="true">↗</span></span>
        </a>
      </article>
    ))}
  </div>
</section>

<style>
  .showcase__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.6rem;
  }
  .showcase__status {
    color: var(--muted);
    font-size: 0.66rem;
    letter-spacing: 0.04em;
    white-space: nowrap;
  }

  .sites { border-top: 1px solid var(--border); }
  .site {
    padding-block: clamp(1.4rem, 4vw, 2rem);
    border-bottom: 1px solid var(--border);
  }
  .site__copy {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1.2rem;
  }
  .site__title { min-width: 0; }
  .site__name { font-size: clamp(1rem, 0.94rem + 0.25vw, 1.12rem); }
  .site__kind {
    display: block;
    margin-top: 0.25rem;
    color: var(--muted);
    font-size: 0.62rem;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }
  .site__link {
    flex: none;
    color: var(--primary);
    font-size: 0.72rem;
    padding-block: 0.16rem;
    border-bottom: 1px solid transparent;
    transition: color 0.18s ease, border-color 0.18s ease;
  }
  .site__link:hover { color: var(--primary-hi); border-bottom-color: currentColor; }
  .site__blurb {
    max-width: 62ch;
    margin: 0.55rem 0 1rem;
    color: var(--muted);
    font-size: 0.86rem;
  }

  .site__visual {
    position: relative;
    display: block;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 12px;
    background: var(--surface-2);
    transition: border-color 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site__visual::after {
    content: "";
    position: absolute;
    inset: 0;
    background: oklch(0.12 0 0 / 0.56);
    opacity: 0;
    transition: opacity 0.25s ease;
  }
  .site__visual img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    object-position: top;
    transition: transform 0.45s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site__visit {
    position: absolute;
    top: 50%;
    left: 50%;
    z-index: 1;
    transform: translate(-50%, calc(-50% + 6px));
    padding: 0.52rem 0.78rem;
    border-radius: 8px;
    background: oklch(0.16 0 0);
    color: oklch(0.98 0 0);
    font-size: 0.72rem;
    font-weight: 600;
    opacity: 0;
    transition: opacity 0.25s ease, transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .site__visual:hover,
  .site__visual:focus-visible { border-color: var(--primary); transform: translateY(-2px); }
  .site__visual:hover::after,
  .site__visual:focus-visible::after { opacity: 1; }
  .site__visual:hover img,
  .site__visual:focus-visible img { transform: scale(1.025); }
  .site__visual:hover .site__visit,
  .site__visual:focus-visible .site__visit {
    opacity: 1;
    transform: translate(-50%, -50%);
  }

  @media (max-width: 520px) {
    .showcase__head { align-items: flex-end; }
    .site__blurb { margin-left: 0; }
    .site__visual { aspect-ratio: 4 / 3; }
    .site__visit {
      top: auto;
      left: auto;
      right: 0.7rem;
      bottom: 0.7rem;
      transform: none;
      opacity: 1;
    }
    .site__visual:hover .site__visit,
    .site__visual:focus-visible .site__visit { transform: none; }
  }

  @media (prefers-reduced-motion: reduce) {
    .site__link,
    .site__visual,
    .site__visual::after,
    .site__visual img,
    .site__visit { transition: none; }
    .site__visual:hover,
    .site__visual:focus-visible { transform: none; }
  }
</style>
