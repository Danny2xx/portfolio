---
import { getCollection } from "astro:content";
import { projects, projectGroups, websites, profile, type Project } from "../data/content";

// project display-name -> case-study slug (published only)
const studies = await getCollection("caseStudies", ({ data }) => !data.draft);
const studyByProject = new Map(studies.map((s) => [s.data.project, s.id]));

type Lnk = { label: string; href: string; ext: boolean };
const linksFor = (p: Project): Lnk[] =>
  [
    p.href ? { label: "Live site", href: p.href, ext: true } : null,
    studyByProject.has(p.name) ? { label: "Case study", href: `/work/${studyByProject.get(p.name)}`, ext: false } : null,
    p.repo ? { label: "Source", href: p.repo, ext: true } : null,
  ].filter((l): l is Lnk => l !== null);

// projects with a real screenshot get the large treatment; the rest are an index
const featured = projects.filter((p) => p.shot);
const indexed = projects.filter((p) => !p.shot);
---

<section class="sec" id="work" data-reveal>
  <div class="sec__head">
    <h2 class="sec__title">Selected work</h2>
    <a class="sec__aside link link--quiet" href={profile.links.github} target="_blank" rel="noreferrer">All repositories</a>
  </div>

  {featured.map((p) => {
    const primary = p.href ?? p.repo;
    return (
      <article class="feature">
        {primary ? (
          <a class="shot" href={primary} target="_blank" rel="noreferrer" tabindex="-1" aria-hidden="true">
            <img src={p.shot} alt="" width="1400" height="800" loading="lazy" />
          </a>
        ) : (
          <div class="shot"><img src={p.shot} alt="" width="1400" height="800" loading="lazy" /></div>
        )}
        <div class="feature__body">
          <div class="feature__top">
            <h3 class="proj__name proj__name--lg">{p.name}</h3>
            {p.note && <span class="proj__note">{p.note}</span>}
          </div>
          <p class="proj__kind">{p.kind}</p>
          <p class="proj__blurb">{p.blurb}</p>
          <p class="proj__stack">{p.stack.join(", ")}</p>
          <p class="proj__links">
            {linksFor(p).map((l) => (
              <a class="link" href={l.href} {...(l.ext ? { target: "_blank", rel: "noreferrer" } : {})}>{l.label}</a>
            ))}
          </p>
        </div>
      </article>
    );
  })}

  {projectGroups.map((g) => {
    const items = indexed.filter((p) => p.group === g.id);
    return (
      items.length > 0 && (
        <div class="group">
          <h3 class="group__title">{g.label}</h3>
          <ul class="projs">
            {items.map((p) => {
              const links = linksFor(p);
              return (
                <li class="proj">
                  <div class="proj__head">
                    <h4 class="proj__name">{p.name}</h4>
                    <p class="proj__kind">{p.kind}</p>
                  </div>
                  <div class="proj__main">
                    {p.note && <p class="proj__note">{p.note}</p>}
                    <p class="proj__blurb">{p.blurb}</p>
                    <p class="proj__stack">{p.stack.join(", ")}</p>
                    {links.length > 0 && (
                      <p class="proj__links">
                        {links.map((l) => (
                          <a class="link" href={l.href} {...(l.ext ? { target: "_blank", rel: "noreferrer" } : {})}>{l.label}</a>
                        ))}
                      </p>
                    )}
                  </div>
                </li>
              );
            })}
          </ul>
        </div>
      )
    );
  })}
</section>

{websites.length > 0 && (
  <section class="sec" id="websites" data-reveal>
    <div class="sec__head">
      <h2 class="sec__title">Websites</h2>
      <span class="sec__aside">{websites.length} live</span>
    </div>
    <div class="sites">
      {websites.map((site, i) => (
        <article class:list={["site", { "site--lead": i === 0 }]}>
          <a class="shot" href={site.url} target="_blank" rel="noreferrer" aria-label={`Visit ${site.name}`}>
            <img src={site.image} alt={site.alt} width="1400" height="800" loading="lazy" />
          </a>
          <div class="site__meta">
            <h3 class="site__name">
              <a class="link" href={site.url} target="_blank" rel="noreferrer">{site.name}</a>
            </h3>
            <span class="site__kind">{site.kind}</span>
          </div>
          <p class="site__blurb">{site.blurb}</p>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  /* screenshots: framed, quiet, slow zoom on hover */
  .shot {
    display: block;
    position: relative;
    overflow: hidden;
    border-radius: 10px;
    aspect-ratio: 16 / 9;
    background: var(--surface-2);
    box-shadow: 0 0 0 1px var(--border);
    transition: box-shadow 0.3s ease;
  }
  .shot img {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.7s var(--ease-out);
  }
  a.shot:hover { box-shadow: 0 0 0 1px var(--border-strong), 0 22px 40px -28px oklch(0 0 0 / 0.35); }
  a.shot:hover img { transform: scale(1.018); }

  /* featured project */
  .feature { margin-bottom: 0.4rem; }
  .feature__body { margin-top: 1rem; }
  .feature__top { display: flex; flex-wrap: wrap; align-items: baseline; gap: 0.25rem 0.8rem; }

  .proj__name { font-size: 0.95rem; font-weight: 600; letter-spacing: -0.01em; line-height: 1.3; }
  .proj__name--lg { font-size: 1.08rem; }
  .proj__note { font-size: 0.78rem; font-weight: 600; color: var(--primary-hi); }
  .proj__kind { font-size: 0.8rem; color: var(--faint); line-height: 1.4; margin-top: 0.1rem; }
  .proj__blurb { color: var(--muted); max-width: 60ch; margin-top: 0.45rem; }
  .proj__stack { font-size: 0.8rem; color: var(--faint); margin-top: 0.45rem; max-width: 60ch; }
  .proj__links { display: flex; flex-wrap: wrap; gap: 0.3rem 1.1rem; margin-top: 0.6rem; font-size: 0.84rem; }

  /* index of the rest */
  .group { margin-top: clamp(2.2rem, 5vw, 2.8rem); }
  .group__title {
    font-size: 0.84rem;
    font-weight: 500;
    color: var(--muted);
    padding-bottom: 0.7rem;
    border-bottom: 1px solid var(--border-strong);
  }
  .projs { list-style: none; margin: 0; padding: 0; }
  .proj {
    display: grid;
    grid-template-columns: 11.5rem 1fr;
    gap: 1.25rem;
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--border);
  }
  .proj:last-child { border-bottom: 0; padding-bottom: 0; }
  .proj__main .proj__note { margin-bottom: -0.2rem; }
  .proj__main .proj__blurb { margin-top: 0; }
  .proj__main .proj__note + .proj__blurb { margin-top: 0.45rem; }
  @media (max-width: 600px) {
    .proj { grid-template-columns: 1fr; gap: 0.45rem; }
  }

  /* websites: one wide, then a pair */
  .sites { display: grid; grid-template-columns: 1fr 1fr; gap: 1.9rem 1.2rem; }
  .site--lead { grid-column: 1 / -1; }
  .site .shot { aspect-ratio: 16 / 10.5; }
  .site--lead .shot { aspect-ratio: 16 / 8.2; }
  .site__meta { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 0.2rem 0.8rem; margin-top: 0.8rem; }
  .site__name { font-size: 0.92rem; font-weight: 600; }
  .site__kind { font-size: 0.8rem; color: var(--faint); }
  .site__blurb { color: var(--muted); margin-top: 0.25rem; font-size: 0.84rem; max-width: 56ch; }
  @media (max-width: 600px) {
    .sites { grid-template-columns: 1fr; }
    .site .shot, .site--lead .shot { aspect-ratio: 16 / 10.5; }
  }

  @media (prefers-reduced-motion: reduce) {
    .shot img { transition: none; }
    a.shot:hover img { transform: none; }
  }
</style>
