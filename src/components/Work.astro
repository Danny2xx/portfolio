---
import { getCollection } from "astro:content";
import { projects, websites } from "../data/content";
import SectionHead from "./SectionHead.astro";
import Pipeline from "./Pipeline.astro";

const featured = projects.filter((p) => p.featured);
const more = projects.filter((p) => !p.featured);

// projects with a published case study get a marker
const studies = await getCollection("caseStudies", ({ data }) => !data.draft);
const hasStudy = new Set(studies.map((s) => s.data.project));
---

<section class="section" id="work">
  <div class="wrap">
    <SectionHead
      title="Selected work"
      desc="Research prototypes and live dashboards. Each one opens into how it works, what it scored, and what didn't."
      meta={`${projects.length} projects · ${hasStudy.size} written up in full`}
    />

    <div class="grid">
      {featured.map((p, i) => (
        <article class:list={["card", `card--${p.featured}`]} data-reveal style={`--d: ${(i % 2) * 110}ms`}>
          <div class:list={["card__visual", { "card__visual--shot": !!p.shot }]}>
            {p.shot ? (
              <img class="card__shot" src={p.shot} alt="" width="1400" height="800" loading="lazy" />
            ) : (
              <Pipeline steps={p.pipeline} />
            )}
          </div>
          <div class="card__body">
            <p class="card__kind">
              {p.kind}
              {hasStudy.has(p.name) && <span class="card__study"> · Case study</span>}
            </p>
            <h3 class="card__title" style={`view-transition-name: title-${p.slug}`}>
              <a class="card__link" href={`/work/${p.slug}`}>{p.name}</a>
            </h3>
            <p class="card__tagline">{p.tagline}</p>
            {p.note && <p class="card__note"><span class="badge badge--line">{p.note}</span></p>}
            <div class="card__foot">
              <span class="card__stack">{p.stack.slice(0, 4).join(" · ")}</span>
              <span class="card__go" aria-hidden="true">View project</span>
            </div>
          </div>
        </article>
      ))}
    </div>

    {more.length > 0 && (
      <div class="more" data-reveal>
        <h3 class="sub">More projects</h3>
        <ul class="rows">
          {more.map((p) => (
            <li>
              <a class="row" href={`/work/${p.slug}`}>
                <span class="row__name" style={`view-transition-name: title-${p.slug}`}>{p.name}</span>
                <span class="row__kind">
                  {p.kind}
                  {hasStudy.has(p.name) && <span class="card__study"> · Case study</span>}
                </span>
                <span class="row__tag">{p.tagline}</span>
                <span class="row__go" aria-hidden="true">
                  <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M6 3.5 10.5 8 6 12.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
                </span>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}

    {websites.length > 0 && (
      <div class="sites" data-reveal>
        <h3 class="sub">Websites I've shipped</h3>
        <div class="sites__track">
          {websites.map((s) => (
            <a class="site" href={s.url} target="_blank" rel="noreferrer">
              <span class="site__frame">
                <img src={s.image} alt={s.alt} width="1400" height="800" loading="lazy" />
              </span>
              <span class="site__meta">
                <span class="site__name">{s.name}</span>
                <span class="site__kind">{s.kind}</span>
              </span>
            </a>
          ))}
        </div>
      </div>
    )}
  </div>
</section>

<style>
  .grid { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); gap: var(--col-gap); }

  .card {
    position: relative;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    border-radius: 22px;
    background: var(--bg-raise);
    box-shadow: inset 0 0 0 1px var(--line);
    transition: box-shadow 0.45s ease, transform 0.7s var(--ease-out);
  }
  .card:hover { box-shadow: inset 0 0 0 1px var(--line-strong), var(--shadow-lg); transform: translateY(-5px); }
  .card:has(.card__link:focus-visible) { outline: 2px solid var(--hl-text); outline-offset: 4px; }

  .card--xl { grid-column: 1 / -1; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); }
  .card--lg { grid-column: span 7; }
  .card--md { grid-column: span 5; }

  .card__visual {
    position: relative;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--surface);
    border-bottom: 1px solid var(--line);
  }
  .card__visual--shot { padding: 0; min-height: 22rem; }
  .card--xl .card__visual { grid-column: 1 / span 7; border-bottom: 0; border-right: 1px solid var(--line); min-height: 28rem; }
  .card__shot {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 1.2s var(--ease-out);
  }
  .card:hover .card__shot { transform: scale(1.035); }

  .card__body { display: flex; flex: 1; flex-direction: column; gap: 0.65rem; padding: clamp(1.5rem, 3vw, 2.25rem); }
  .card--xl .card__body { grid-column: 8 / -1; justify-content: center; padding: clamp(2rem, 4vw, 3.25rem); }
  .card__kind { font-size: 0.84rem; color: var(--faint); }
  .card__study { color: var(--hl-text); }
  .card__title { font-size: clamp(1.65rem, 1.1rem + 1.5vw, 2.4rem); font-stretch: 112%; font-weight: 700; letter-spacing: -0.03em; line-height: 1; }
  .card--xl .card__title { font-size: clamp(2.1rem, 1.2rem + 2.6vw, 3.5rem); }
  .card__link::after { content: ""; position: absolute; inset: 0; border-radius: inherit; }
  .card__link:focus-visible { outline: none; }
  .card__tagline { max-width: 42ch; color: var(--muted); }
  .card__note { margin-top: 0.2rem; }
  .card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.3rem;
    font-size: 0.82rem;
  }
  .card__stack { color: var(--faint); }
  .card__go {
    flex: none;
    padding-bottom: 2px;
    font-weight: 620;
    color: var(--ink);
    background: linear-gradient(var(--hl-text), var(--hl-text)) no-repeat 0 100% / 0% 2px;
    transition: background-size 0.5s var(--ease-out);
  }
  .card:hover .card__go { background-size: 100% 2px; }

  /* sub-blocks */
  .sub { font-size: clamp(1.3rem, 1.05rem + 0.8vw, 1.75rem); font-stretch: 110%; font-weight: 680; letter-spacing: -0.025em; }

  .more { margin-top: clamp(4rem, 9vw, 6.5rem); }
  .rows { list-style: none; margin: 1.5rem 0 0; padding: 0; border-top: 1px solid var(--line); }
  .row {
    position: relative;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    column-gap: var(--col-gap);
    align-items: baseline;
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--line);
  }
  .row::before {
    content: "";
    position: absolute;
    inset: 0 calc(-1 * var(--gutter) / 2);
    border-radius: 14px;
    background: var(--surface);
    opacity: 0;
    transition: opacity 0.35s ease;
    z-index: -1;
  }
  .row:hover::before { opacity: 1; }
  .row__name {
    display: inline-block;
    grid-column: 1 / span 4;
    font-size: clamp(1.25rem, 1rem + 0.8vw, 1.7rem);
    font-stretch: 110%;
    font-weight: 680;
    letter-spacing: -0.025em;
    line-height: 1.1;
    transition: transform 0.5s var(--ease-out), color 0.3s ease;
  }
  .row:hover .row__name { transform: translateX(6px); color: var(--hl-text); }
  .row__kind { grid-column: 5 / span 3; font-size: 0.88rem; color: var(--faint); }
  .row__tag { grid-column: 8 / span 4; color: var(--muted); }
  .row__go { grid-column: 12; justify-self: end; color: var(--faint); transition: transform 0.5s var(--ease-out), color 0.3s ease; }
  .row:hover .row__go { transform: translateX(4px); color: var(--ink); }

  .sites { margin-top: clamp(4rem, 9vw, 6.5rem); }
  .sites__track { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--col-gap); margin-top: 1.5rem; }
  .site { display: block; }
  .site__frame {
    display: block;
    overflow: hidden;
    aspect-ratio: 16 / 10.5;
    border-radius: 16px;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
  }
  .site__frame img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: top; transition: transform 1s var(--ease-out); }
  .site:hover .site__frame img { transform: scale(1.04); }
  .site__meta { display: flex; justify-content: space-between; gap: 1rem; margin-top: 0.85rem; font-size: 0.9rem; }
  .site__name { font-weight: 620; }
  .site__kind { color: var(--faint); }

  @media (max-width: 900px) {
    .card--xl, .card--lg, .card--md { grid-column: 1 / -1; }
    .card--xl { display: flex; flex-direction: column; }
    .card--xl .card__visual { min-height: 0; aspect-ratio: 16 / 10; border-right: 0; border-bottom: 1px solid var(--line); }
    .card__visual--shot { min-height: 0; aspect-ratio: 16 / 10; }
    .row { grid-template-columns: minmax(0, 1fr) auto; row-gap: 0.3rem; }
    .row__name { grid-column: 1; }
    .row__go { grid-column: 2; grid-row: 1; }
    .row__kind, .row__tag { grid-column: 1 / -1; }
    .row::before { inset: 0 -0.6rem; }
    .sites__track {
      grid-template-columns: none;
      grid-auto-flow: column;
      grid-auto-columns: 82%;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      padding-bottom: 0.5rem;
      scrollbar-width: none;
    }
    .site { scroll-snap-align: start; }
  }
  @media (prefers-reduced-motion: reduce) {
    .card, .card__shot, .site__frame img, .row__name, .row__go { transition: none; }
  }
</style>
