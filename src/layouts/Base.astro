---
import "../styles/global.css";
import { profile } from "../data/content";
import Settings from "../components/Settings.astro";
import Dock from "../components/Dock.astro";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${profile.name} · ${profile.title}`,
  description = "Daniel Iyalekhue, AI / ML engineer in Birmingham. Retrieval, evaluation, models and the products around them. Co-author of an ICACIN 2026 paper.",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? "https://danieliyalekhue.com");
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="color-scheme" content="dark light" />
    <meta name="theme-color" content="#0f0f0f" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- theme and accessibility prefs, applied before paint so nothing flashes -->
    <script is:inline>
      (() => {
        const el = document.documentElement;
        try {
          el.dataset.theme = localStorage.getItem("theme") === "light" ? "light" : "dark";
          if (localStorage.getItem("a11y-contrast") === "high") el.dataset.contrast = "high";
          if (localStorage.getItem("a11y-font") === "dyslexic") el.dataset.font = "dyslexic";
          if (localStorage.getItem("a11y-motion") === "reduced") el.dataset.motion = "reduced";
          const ts = localStorage.getItem("a11y-textscale");
          if (ts) el.style.setProperty("--ts", ts);
        } catch (_) {
          el.dataset.theme = "dark";
        }
        if (el.dataset.theme === "light") {
          document.querySelector('meta[name="theme-color"]')?.setAttribute("content", "#fbfbfa");
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <Settings />
    <slot />
    <Dock />

    <script>
      // Navigation should never make you wait: the page you are about to open
      // is fetched the moment you show intent.
      {
        const seen = new Set<string>();
        const warm = (href: string) => {
          if (!href || seen.has(href)) return;
          seen.add(href);
          const l = document.createElement("link");
          l.rel = "prefetch";
          l.href = href;
          l.as = "document";
          document.head.appendChild(l);
        };
        const intent = (e: Event) => {
          const a = (e.target as HTMLElement)?.closest?.("a[href^='/']") as HTMLAnchorElement | null;
          if (a && !a.target) warm(a.getAttribute("href")!);
        };
        addEventListener("pointerover", intent, { passive: true, capture: true });
        addEventListener("touchstart", intent, { passive: true, capture: true });
        addEventListener("focusin", intent, { passive: true, capture: true });

        // and the first few project pages get fetched while the browser is idle
        const idle = (window as any).requestIdleCallback || ((f: Function) => setTimeout(f, 1200));
        idle(() => {
          document.querySelectorAll<HTMLAnchorElement>("a[data-prefetch]").forEach((a, i) => {
            if (i < 4) warm(a.getAttribute("href")!);
          });
        });
      }

      // Progressive disclosure: the page stays short, nothing is thrown away.
      for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-more]")) {
        const fold = document.getElementById(btn.getAttribute("aria-controls") || "");
        if (!fold) continue;
        const label = btn.querySelector("span")!;
        const closed = label.textContent || "More";
        btn.addEventListener("click", () => {
          const open = btn.getAttribute("aria-expanded") === "true";
          btn.setAttribute("aria-expanded", String(!open));
          fold.classList.toggle("is-open", !open);
          label.textContent = open ? closed : "Less";
        });
      }

      // One toggle per section unclamps every clamped line inside it.
      for (const btn of document.querySelectorAll<HTMLButtonElement>("[data-clamp]")) {
        const sec = btn.closest(".sec");
        if (!sec) continue;
        const label = btn.querySelector("span")!;
        const closed = label.textContent || "Full detail";
        btn.addEventListener("click", () => {
          const open = btn.getAttribute("aria-expanded") === "true";
          btn.setAttribute("aria-expanded", String(!open));
          sec.classList.toggle("is-open", !open);
          label.textContent = open ? closed : "Less";
        });
      }

      // The sticky label of the section you are actually in marks itself, so a
      // long column always says where you are without a nav.
      const labels = Array.from(document.querySelectorAll<HTMLElement>(".sec > .label"));
      if (labels.length > 1 && !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
        let queued = false;
        const mark = () => {
          queued = false;
          let current: HTMLElement | null = null;
          for (const l of labels) {
            const sec = l.parentElement!;
            const r = sec.getBoundingClientRect();
            if (r.top <= 72 && r.bottom > 96) current = l;
          }
          for (const l of labels) l.classList.toggle("is-on", l === current);
        };
        addEventListener("scroll", () => {
          if (!queued) { queued = true; requestAnimationFrame(mark); }
        }, { passive: true });
        mark();
      }
    </script>
  </body>
</html>
