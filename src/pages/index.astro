---
import Base from "../layouts/Base.astro";
import Profile from "../components/Profile.astro";
import FeedProfile from "../components/FeedProfile.astro";
import FeedWork from "../components/FeedWork.astro";
import FeedAbout from "../components/FeedAbout.astro";
import LabPanel from "../components/LabPanel.astro";
import Footer from "../components/Footer.astro";
---

<Base>
  <main id="main" class="col" style="padding-block: 44px 132px">
    <span id="top"></span>
    <Profile>
      <FeedProfile slot="profile" />
      <FeedWork slot="work" />
      <FeedAbout slot="about" />
      <LabPanel slot="lab" />
    </Profile>
    <Footer />
  </main>
</Base>
