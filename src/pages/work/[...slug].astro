---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Dock from "../../components/Dock.astro";
import { profile } from "../../data/content";

export async function getStaticPaths() {
  const studies = await getCollection("caseStudies", ({ data }) => !data.draft);
  return studies.map((s) => ({ params: { slug: s.id }, props: { study: s } }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const d = study.data;
---

<Base title={`${d.project} case study · ${profile.name}`} description={d.summary}>
  <Nav />
  <main id="main" class="page">
    <article class="feed">
      <a class="back" href="/#projects">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>
        Projects
      </a>

      <header class="cs">
        <p class="cs__kicker">Case study</p>
        <h1 class="page__title">{d.title}</h1>
        <p class="page__sub">{d.summary}</p>

        <dl class="cs__meta">
          <div><dt>Project</dt><dd>{d.project}</dd></div>
          <div><dt>Year</dt><dd>{d.year}</dd></div>
          {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
          {d.stack.length > 0 && <div class="cs__stack"><dt>Stack</dt><dd>{d.stack.join(", ")}</dd></div>}
        </dl>

        {(d.demo || d.repo) && (
          <div class="cs__links">
            {d.demo && <a class="btn btn--solid" href={d.demo} target="_blank" rel="noreferrer">Live demo</a>}
            {d.repo && <a class="btn btn--line" href={d.repo} target="_blank" rel="noreferrer">Source</a>}
          </div>
        )}
      </header>

      {d.video && (
        <figure class="cs__demo">
          <video src={d.video} poster={d.poster} controls preload="none" playsinline muted loop></video>
          <figcaption>{d.project}, screen capture</figcaption>
        </figure>
      )}

      <div class="prose cs__body">
        <Content />
      </div>

      <footer class="foot">
        <a class="link" href="/#projects">All projects</a>
        <a class="link" href={`mailto:${profile.email}`}>Questions? Email me</a>
      </footer>
    </article>
  </main>
  <Footer />
  <Dock />
</Base>

<style>
  .cs__kicker { font-size: 0.84rem; color: var(--primary-hi); font-weight: 600; margin-bottom: 0.5rem; }

  .cs__meta {
    display: grid;
    grid-template-columns: repeat(3, auto) 1fr;
    gap: 0.8rem 2rem;
    margin: 1.6rem 0 0;
    padding-top: 1.1rem;
    border-top: 1px solid var(--border);
  }
  .cs__meta dt { font-size: 0.78rem; color: var(--faint); }
  .cs__meta dd { margin: 0.1rem 0 0; font-size: 0.88rem; color: var(--ink); }
  .cs__stack { min-width: 0; }
  @media (max-width: 600px) {
    .cs__meta { grid-template-columns: repeat(3, auto); }
    .cs__stack { grid-column: 1 / -1; }
  }

  .cs__links { display: flex; flex-wrap: wrap; gap: 0.55rem; margin-top: 1.3rem; }

  .cs__demo { margin: clamp(1.8rem, 4vw, 2.6rem) 0 0; }
  .cs__demo video {
    width: 100%; display: block; border-radius: 10px;
    box-shadow: 0 0 0 1px var(--border); background: var(--surface-2); aspect-ratio: 16 / 9;
  }
  .cs__demo figcaption { margin-top: 0.5rem; font-size: 0.8rem; color: var(--faint); }

  .cs__body { margin-top: clamp(2rem, 5vw, 2.8rem); }

  .foot {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-top: 3rem; padding-top: 1.4rem; border-top: 1px solid var(--border);
  }
</style>
