---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import Dock from "../../components/Dock.astro";
import { profile } from "../../data/content";

export async function getStaticPaths() {
  const studies = await getCollection("caseStudies", ({ data }) => !data.draft);
  return studies.map((s) => ({ params: { slug: s.id }, props: { study: s } }));
}

const { study } = Astro.props;
const { Content } = await render(study);
const d = study.data;
---

<Base title={`${d.project} — case study — ${profile.name}`} description={d.summary}>
  <Nav />
  <main id="top" class="page">
    <article class="feed">
      <a class="back" href="/#projects">← Projects</a>

      <header class="cs__head">
        <span class="label">Case study</span>
        <h1>{d.title}</h1>
        <p class="cs__summary">{d.summary}</p>

        <dl class="cs__meta mono">
          <div><dt>Project</dt><dd>{d.project}</dd></div>
          <div><dt>Year</dt><dd>{d.year}</dd></div>
          {d.role && <div><dt>Role</dt><dd>{d.role}</dd></div>}
        </dl>

        {d.stack.length > 0 && (
          <ul class="cs__stack">
            {d.stack.map((s) => <li class="cs__chip mono">{s}</li>)}
          </ul>
        )}

        {(d.demo || d.repo) && (
          <div class="cs__links">
            {d.demo && <a class="cs__btn cs__btn--go" href={d.demo} target="_blank" rel="noreferrer">Live demo →</a>}
            {d.repo && <a class="cs__btn" href={d.repo} target="_blank" rel="noreferrer">Source</a>}
          </div>
        )}
      </header>

      {d.video && (
        <figure class="cs__demo">
          <video src={d.video} poster={d.poster} controls preload="none" playsinline muted loop></video>
          <figcaption class="mono">{d.project} running · screen capture</figcaption>
        </figure>
      )}

      <hr class="rule cs__rule" />

      <div class="prose">
        <Content />
      </div>

      <footer class="cs__foot">
        <a href="/#projects">← All projects</a>
        <a href={`mailto:${profile.email}`}>Questions? Email me →</a>
      </footer>
    </article>
  </main>
  <Footer />
  <Dock />
</Base>

<style>
  .page { padding-top: clamp(5.5rem, 8vw, 7rem); padding-bottom: clamp(5rem, 9vw, 7rem); }
  .back { display: inline-block; font-family: var(--font-mono); font-size: 0.72rem; color: var(--muted); margin-bottom: 2rem; }
  .back:hover { color: var(--ink); }

  .cs__head { display: flex; flex-direction: column; gap: 0.9rem; }
  .cs__head h1 { font-size: clamp(1.5rem, 1.15rem + 1.6vw, 2.1rem); }
  .cs__summary { color: var(--muted); font-size: 1rem; max-width: 62ch; }

  .cs__meta { display: flex; flex-wrap: wrap; gap: 1.6rem; margin-top: 0.4rem; }
  .cs__meta div { display: flex; flex-direction: column; gap: 0.15rem; }
  .cs__meta dt { font-size: 0.6rem; letter-spacing: 0.08em; text-transform: uppercase; color: var(--faint); }
  .cs__meta dd { margin: 0; font-size: 0.82rem; color: var(--ink); }

  .cs__stack { list-style: none; margin: 0.4rem 0 0; padding: 0; display: flex; flex-wrap: wrap; gap: 0.4rem; }
  .cs__chip { font-size: 0.68rem; color: var(--muted); border: 1px solid var(--border); border-radius: 6px; padding: 0.24rem 0.5rem; }

  .cs__links { display: flex; gap: 0.6rem; margin-top: 0.6rem; }
  .cs__btn {
    font-size: 0.8rem; font-weight: 560; padding: 0.5rem 0.9rem; border-radius: 9px;
    border: 1px solid var(--border-strong); color: var(--ink); transition: border-color 0.18s ease, transform 0.18s ease;
  }
  .cs__btn:hover { border-color: var(--primary); transform: translateY(-1px); }
  .cs__btn--go { background: var(--primary); color: var(--on-primary); border-color: var(--primary); }
  .cs__btn--go:hover { background: var(--primary-hi); }

  .cs__demo { margin: clamp(1.8rem, 4vw, 2.6rem) 0 0; }
  .cs__demo video {
    width: 100%; display: block; border-radius: 14px;
    border: 1px solid var(--border); background: var(--surface-2); aspect-ratio: 16 / 9;
  }
  .cs__demo figcaption { margin-top: 0.5rem; font-size: 0.68rem; color: var(--faint); letter-spacing: 0.04em; }

  .cs__rule { margin-block: clamp(2rem, 5vw, 2.8rem); }

  .prose { max-width: 68ch; color: var(--ink); font-size: 0.95rem; line-height: 1.72; }
  .prose :global(p) { margin: 0 0 1.15rem; color: var(--muted); }
  .prose :global(h2) { font-size: 1.05rem; font-weight: 600; margin: 2.2rem 0 0.8rem; color: var(--ink); letter-spacing: -0.01em; }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(em) { font-style: italic; }
  .prose :global(a) { color: var(--primary); text-decoration: underline; text-underline-offset: 3px; }
  .prose :global(a:hover) { color: var(--primary-hi); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 1.15rem; padding-left: 1.3rem; color: var(--muted); display: flex; flex-direction: column; gap: 0.5rem; }
  .prose :global(li) { padding-left: 0.2rem; }
  .prose :global(li::marker) { color: var(--primary); }
  .prose :global(ol li::marker) { font-family: var(--font-mono); font-size: 0.85em; }
  .prose :global(code) { font-family: var(--font-mono); font-size: 0.86em; color: var(--ink); background: var(--surface-2); border: 1px solid var(--border); border-radius: 5px; padding: 0.1em 0.35em; }

  .cs__foot {
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    margin-top: 3rem; padding-top: 1.4rem; border-top: 1px solid var(--border);
    font-family: var(--font-mono); font-size: 0.78rem;
  }
  .cs__foot a { color: var(--primary); }
  .cs__foot a:hover { color: var(--primary-hi); }
</style>
