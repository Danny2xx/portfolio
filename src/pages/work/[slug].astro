---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import { projects, profile } from "../../data/content";

export async function getStaticPaths() {
  return projects.map((p, i) => ({ params: { slug: p.slug }, props: { index: i } }));
}

const { index } = Astro.props;
const p = projects[index];
const next = projects[(index + 1) % projects.length];

const studies = await getCollection("caseStudies", ({ data }) => !data.draft);
const study = studies.find((s) => s.data.project === p.name);
const Content = study ? (await render(study)).Content : null;
---

<Base title={`${p.name} · ${profile.name}`} description={p.tagline} image={p.shot ?? "/og.png"}>
  <main id="main" class="col page">
    <span id="top"></span>

    <a class="back" href="/">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Back
    </a>

    <h1 class="page__title">{p.name}</h1>
    <p class="page__sub">{p.tagline}</p>
    <p class="page__meta">
      <span>{p.kind}</span>
      {p.role && <span>· {p.role}</span>}
      {p.note && <span>· {p.note}</span>}
    </p>

    {(p.href || p.repo) && (
      <div class="btnrow">
        {p.href && <a class="btn btn--go" href={p.href} target="_blank" rel="noreferrer">Open live site ↗</a>}
        {p.repo && <a class="btn" href={p.repo} target="_blank" rel="noreferrer">Source ↗</a>}
      </div>
    )}

    {p.shot && (
      <figure class="shot">
        <img src={p.shot} alt={`${p.name} interface`} width="1600" height="1000" loading="lazy" />
      </figure>
    )}

    <section class="sec">
      <h2 class="label">What it is</h2>
      <p>{p.blurb}</p>
    </section>

    <section class="sec">
      <h2 class="label">How it works</h2>
      <!-- the trace runs as you scroll it: the rail fills, each stage lights
           as it reaches the reading line. All CSS, no scroll listener. -->
      <div class="trace">
        <span class="trace__track" aria-hidden="true"></span>
        <span class="trace__rail" aria-hidden="true"></span>
        <ol class="trace__steps">
          {p.pipeline.map((step, i) => (
            <li class="trace__step" style={`--i:${i}`}>
              <span class="trace__dot" aria-hidden="true"></span>
              <span class="trace__body">
                <span class="t">{step.label}</span>
                {step.detail && <span class="d">{step.detail}</span>}
              </span>
              <span class="meta">{String(i + 1).padStart(2, "0")}</span>
            </li>
          ))}
        </ol>
      </div>
    </section>

    {p.facts && p.facts.length > 0 && (
      <section class="sec">
        <h2 class="label">Measured</h2>
        <div class="rows">
          {p.facts.map((f, i) => (
            <div class="row row--plain" style={`--i:${i}`}>
              <span class="t" style="font-weight:400">{f.label}</span>
              <span class="meta" style="color:var(--ink)">{f.value}</span>
            </div>
          ))}
        </div>
        {p.caveat && <p class="caveat">{p.caveat}</p>}
      </section>
    )}

    {p.highlights && p.highlights.length > 0 && (
      <section class="sec">
        <h2 class="label">Engineering decisions</h2>
        <div class="rows">
          {p.highlights.map((h, i) => (
            <div class="row row--plain" style={`--i:${i}`}><span class="d" style="color:var(--ink)">{h}</span></div>
          ))}
        </div>
      </section>
    )}

    <section class="sec">
      <h2 class="label">Built with</h2>
      <div class="chips">
        {p.stack.map((s) => <span class="chip">{s}</span>)}
      </div>
    </section>

    {Content && (
      <section class="sec">
        <h2 class="label">Case study</h2>
        <div class="prose"><Content /></div>
      </section>
    )}

    <a class="next" href={`/work/${next.slug}`}>
      <span class="label" style="position:static;margin:0;padding:0;background:none">Next</span>
      <span class="t">{next.name}</span>
      <span class="d">{next.tagline}</span>
    </a>

    <Footer />
  </main>
</Base>

<style>
  /* ── the pipeline as a trace ─────────────────────────────────────────── */
  .trace { position: relative; margin-top: 6px; padding-left: 22px; }
  .trace__track, .trace__rail {
    position: absolute; left: 5px; top: 14px; bottom: 14px; width: 1px;
  }
  .trace__track { background: var(--line); }
  .trace__rail { background: var(--accent); height: 100%; transform-origin: top; }

  .trace__steps { list-style: none; margin: 0; padding: 0; }
  .trace__step {
    position: relative; display: grid;
    grid-template-columns: minmax(0, 1fr) auto; gap: 10px; align-items: start;
    padding: 9px 0; border-bottom: 1px solid var(--line);
  }
  .trace__step:last-child { border-bottom: 0; }
  .trace__dot {
    position: absolute; left: -22px; top: 15px; width: 11px; height: 11px;
    border-radius: 50%; background: var(--bg);
    box-shadow: inset 0 0 0 1.5px var(--line-strong);
    transition: box-shadow 0.3s ease, transform 0.4s var(--ease);
  }
  .trace__body { display: block; min-width: 0; }

  /* default, and the fallback wherever scroll timelines are missing: fully lit */
  .trace__step { opacity: 1; }
  .trace__dot { box-shadow: inset 0 0 0 1.5px var(--accent), 0 0 0 3px color-mix(in oklab, var(--accent) 16%, transparent); }

  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .trace__rail {
        height: 0;
        animation: trace-fill linear both;
        animation-timeline: view();
        animation-range: cover 14% cover 72%;
      }
      @keyframes trace-fill { to { height: 100%; } }

      .trace__step {
        opacity: 0.45;
        animation: trace-step linear both;
        animation-timeline: view();
        animation-range: cover 24% cover 46%;
      }
      @keyframes trace-step { to { opacity: 1; } }

      .trace__dot {
        box-shadow: inset 0 0 0 1.5px var(--line-strong);
        animation: trace-dot linear both;
        animation-timeline: view();
        animation-range: cover 24% cover 46%;
      }
      @keyframes trace-dot {
        to { box-shadow: inset 0 0 0 1.5px var(--accent), 0 0 0 3px color-mix(in oklab, var(--accent) 16%, transparent); }
      }
    }
  }

  .shot { margin: 22px 0 0; border: 1px solid var(--line); border-radius: 12px; overflow: hidden; background: var(--card); }
  .shot img { display: block; width: 100%; height: auto; }
  .caveat { margin-top: 12px; padding: 10px 12px; border-radius: 10px; background: var(--card); color: var(--mid); font-size: calc(13px * var(--ts)); }
  .next { display: block; margin-top: 40px; padding-top: 16px; border-top: 1px solid var(--line); }
  .next .t { margin-top: 6px; font-size: calc(18px * var(--ts)); letter-spacing: -0.3px; transition: color 0.2s ease; }
  .next:hover .t { color: var(--accent); }
</style>
