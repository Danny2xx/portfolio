---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import { profile } from "../../data/content";

export async function getStaticPaths() {
  const posts = await getCollection("writing", ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { year: "numeric", month: "long", day: "numeric" });
---

<Base title={`${post.data.title} · ${profile.name}`} description={post.data.description} page="sub">
  <main id="main" class="page">
    <article class="wrap wrap--narrow">
      <a class="back" href="/writing">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        All notes
      </a>

      <h1 class="page__title display">{post.data.title}</h1>
      <time class="date" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>

      <div class="prose"><Content /></div>

      <footer class="foot">
        <a class="link" href="/writing">All notes</a>
        <a class="link" href={`mailto:${profile.email}`}>Reply by email</a>
      </footer>
    </article>
  </main>
</Base>

<style>
  .date { display: block; margin-top: 1.2rem; font-size: 0.9rem; color: var(--faint); }
  .prose { margin-top: clamp(2.5rem, 6vw, 3.5rem); }
  .foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 3.5rem;
    padding-top: 1.6rem;
    border-top: 1px solid var(--line);
  }
</style>
