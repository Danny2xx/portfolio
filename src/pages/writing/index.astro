---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import { profile } from "../../data/content";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { year: "numeric", month: "short", day: "numeric" });
---

<Base title={`Writing · ${profile.name}`} description="Notes on AI engineering, building, and what I'm learning." page="sub">
  <main id="main" class="page">
    <div class="wrap wrap--narrow">
      <a class="back" href="/">
        <svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
        Home
      </a>

      <h1 class="page__title display">Notes</h1>
      <p class="page__sub">Working notes on AI engineering, building, and what I'm learning.</p>

      {posts.length === 0 ? (
        <p class="empty">First post landing soon.</p>
      ) : (
        <ul class="posts" data-stagger>
          {posts.map((post) => (
            <li>
              <a class="post" href={`/writing/${post.id}`}>
                <time class="post__date" datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time>
                <h2 class="post__title">{post.data.title}</h2>
                <p class="post__desc">{post.data.description}</p>
              </a>
            </li>
          ))}
        </ul>
      )}
    </div>
  </main>
</Base>

<style>
  .empty { margin-top: 3rem; color: var(--faint); }
  .posts { list-style: none; margin: clamp(2.5rem, 6vw, 4rem) 0 0; padding: 0; border-top: 1px solid var(--line); }
  .post { display: block; padding-block: 1.6rem; border-bottom: 1px solid var(--line); }
  .post__date { font-size: 0.86rem; color: var(--faint); }
  .post__title {
    margin-top: 0.5rem;
    font-size: clamp(1.4rem, 1.1rem + 1vw, 1.9rem);
    font-stretch: 108%;
    font-weight: 660;
    letter-spacing: -0.025em;
    transition: color 0.3s ease, transform 0.5s var(--ease-out);
  }
  .post:hover .post__title { color: var(--hl-text); transform: translateX(6px); }
  .post__desc { max-width: 58ch; margin-top: 0.5rem; color: var(--muted); }
</style>
