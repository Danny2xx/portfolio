---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Footer from "../../components/Footer.astro";
import { profile } from "../../data/content";

const posts = (await getCollection("writing", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const fmt = (d: Date) => d.toLocaleDateString("en-GB", { year: "numeric", month: "short" });
---

<Base title={`Notes · ${profile.name}`} description="Working notes on AI engineering and what I'm building.">
  <main id="main" class="col page">
    <span id="top"></span>

    <a class="back" href="/">
      <svg width="12" height="12" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path d="M10 3.5 5.5 8l4.5 4.5" stroke-linecap="round" stroke-linejoin="round" /></svg>
      Back
    </a>

    <h1 class="page__title">Notes</h1>
    <p class="page__sub">Working notes on AI engineering, building, and what I'm learning.</p>

    <section class="sec">
      {posts.length === 0 ? (
        <p class="d">First note landing soon.</p>
      ) : (
        <div class="rows">
          {posts.map((post, i) => (
            <a class="row row--plain" href={`/writing/${post.id}`} style={`--i:${i}`}>
              <span>
                <span class="t">{post.data.title}</span>
                <span class="d">{post.data.description}</span>
              </span>
              <span class="go">{fmt(post.data.date)} ↗</span>
            </a>
          ))}
        </div>
      )}
    </section>

    <Footer />
  </main>
</Base>
